---
import Layout from '../layouts/Layout.astro';
import Mermaid from '../components/Mermaid.astro';
import Workflow from '../components/Workflow.astro';
import Stages from '../components/Stages.astro';
import Annotated from '../components/Annotated.astro';
import Callout from '../components/Callout.astro';
import EventStream from '../components/EventStream.astro';
import PageNext from '../components/PageNext.astro';

const pipelines = [
  {
    name: 'ship-a-feature',
    tag: 'default',
    tone: 'accent',
    when: 'Ship X · build Y · end-to-end feature work',
    when_short: 'feature work',
  },
  {
    name: 'fix-a-bug',
    tag: 'recovery',
    tone: 'warn',
    when: 'Something broken · reproduce, isolate, fix, verify, land',
    when_short: 'something broken',
  },
  {
    name: 'plan-and-delegate',
    tag: 'team-of-N',
    tone: 'accent-2',
    when: 'Fan out across disjoint lanes via the coordinator primitive',
    when_short: 'team of N',
  },
];
---

<Layout title="How it works" pathname="/how-it-works">
  <section class="page-head">
    <div class="container">
      <div class="eyebrow-chain">
        <span class="eyebrow">How it works</span>
        <span class="eyebrow-sep">·</span>
        <span class="eyebrow-dim">substrate → pipeline → coordinator</span>
      </div>
      <h1>One mental model. <span class="dim-h1">One default execution path.</span></h1>
      <p class="lede">
        Máddu has <em>one substrate loop</em> and <em>one default pipeline</em>. They're the same loop at two altitudes — the slash and autopilot surfaces are friendly wrappers over the substrate, never competing flows.
      </p>
    </div>
  </section>

  <!-- ── SUBSTRATE ────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 01 · The substrate</span>
        <h2>Six transitions. Every layer reduces to this.</h2>
        <p>Each transition writes exactly one event to the spine. Hindsight feeds back into skills and memory after the slice-stop, so learning persists across agents.</p>
      </header>

      <Workflow
        eyebrow="Substrate loop"
        title="register → claim → slice → stop → release → close"
        subtitle="The single mental model. Tone-coded by event family."
        meta="6 transitions"
        tone="accent"
      >
        <Stages
          stages={[
            { label: 'register', sub: 'session',  tone: 'session' },
            { label: 'claim',    sub: 'lane',     tone: 'lane' },
            { label: 'slice',    sub: 'work',     tone: 'framework' },
            { label: 'stop',     sub: 'slice',    tone: 'approval' },
            { label: 'release',  sub: 'lane',     tone: 'lane' },
            { label: 'close',    sub: 'session',  tone: 'session' },
          ]}
          numbered
        />
        <Annotated
          columns={['Transition', 'What it bounds', 'Spine event']}
          rows={[
            { action: 'session register', effect: 'binds an agent identity to this turn',     provenance: 'SESSION_REGISTERED', provTone: 'session' },
            { action: 'lane claim',       effect: 'bounds concurrency to one file area',     provenance: 'LANE_CLAIMED',       provTone: 'lane' },
            { action: 'slice',            effect: 'one unit of work, observable end-to-end', provenance: 'SLICE_STARTED',      provTone: 'framework' },
            { action: 'slice-stop',       effect: 'structured close + hindsight extraction', provenance: 'SLICE_STOPPED',      provTone: 'approval' },
            { action: 'lane release',     effect: 'next agent can claim this area',          provenance: 'LANE_RELEASED',      provTone: 'lane' },
            { action: 'session close',    effect: 'closes the agent identity cleanly',       provenance: 'SESSION_CLOSED',     provTone: 'session' },
          ]}
        />
        <Fragment slot="outcome">
          Replay is deterministic. Past state reconstructs from the spine alone.
        </Fragment>
      </Workflow>

      <EventStream
        eyebrow="What lands on disk · sample slice trace"
        title="spine · turn 12"
      />
    </div>
  </section>

  <!-- ── PIPELINES ────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 02 · The default execution path</span>
        <h2>Pipelines walk the substrate for you.</h2>
        <p>
          For non-trivial work, the agent reaches for a pipeline first. Each stage is a literal <span class="verb">maddu</span> verb against the substrate above. Walking a pipeline exercises and populates every feature surface — Plans, Reviews, Loops, Cost — by construction.
        </p>
      </header>

      <Workflow
        eyebrow="ship-a-feature · DEFAULT"
        title="orient → plan → coordinate → slice → test → review → land → account"
        subtitle="Eight stages, each one a verb. Tone-coded by purpose area."
        meta="8 stages"
        tone="accent-2"
      >
        <Stages
          stages={[
            { label: 'orient',     tone: 'framework' },
            { label: 'plan',       tone: 'accent' },
            { label: 'coordinate', tone: 'accent' },
            { label: 'slice',      tone: 'lane' },
            { label: 'test',       tone: 'ok' },
            { label: 'review',     tone: 'ok' },
            { label: 'land',       tone: 'accent-2' },
            { label: 'account',    tone: 'session' },
          ]}
          numbered
        />
        <Annotated
          columns={['Stage', 'Effect', 'Spine event']}
          rows={[
            { action: 'maddu brief',         effect: 'turn-start orientation digest',          provenance: 'BRIEF_RENDERED',     provTone: 'framework' },
            { action: 'maddu plan',          effect: 'goal → phases · auto-revising',          provenance: 'PLAN_PERSISTED',     provTone: 'accent' },
            { action: 'maddu coordinator',   effect: 'fans work across the team',              provenance: 'COORDINATOR_STARTED', provTone: 'accent' },
            { action: 'maddu lane claim',    effect: 'binds slice to one file area',           provenance: 'LANE_CLAIMED',       provTone: 'lane' },
            { action: 'maddu review',        effect: 'quality gates run',                      provenance: 'REVIEW_RAN',         provTone: 'ok' },
            { action: 'maddu slice-stop',    effect: 'structured close + hindsight',           provenance: 'SLICE_STOPPED',      provTone: 'approval' },
            { action: 'maddu cost',          effect: 'receipt ledger accounting',              provenance: 'TOKEN_USAGE_REPORTED', provTone: 'session' },
          ]}
        />
        <Fragment slot="outcome">
          Pipeline state is itself an event. Re-runs are deterministic against the same goal.
        </Fragment>
      </Workflow>

      <h3 class="post-eyebrow">Three pipelines ship by default</h3>
      <div class="pipeline-grid">
        {pipelines.map((p, i) => (
          <article class:list={['pipeline-card', `pipeline-card--${p.tone}`]}>
            <header>
              <span class="pipeline-num">{String(i + 1).padStart(2, '0')}</span>
              <h4 class="pipeline-name"><code>{p.name}</code></h4>
              <span class:list={['pipeline-tag', `pipeline-tag--${p.tone}`]}>{p.tag}</span>
            </header>
            <p class="pipeline-when">{p.when}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SLICE-STOP RITUAL ────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 03 · The slice-stop ritual</span>
        <h2>Where every slice ends.</h2>
        <p>
          Every working slice ends with a structured stop. This is what feeds the hindsight extractor, the pattern projector, and the operator's audit trail. The schema is intentional — it makes machine-extractable what an unstructured "I'm done" would lose.
        </p>
      </header>

      <Workflow
        eyebrow="Slice-stop schema"
        title="Seven fields that survive context loss."
        meta="audit · hindsight · approval"
        tone="warn"
      >
        <dl class="slice-fields">
          <div class="slice-field">
            <dt>Action</dt>
            <dd>what changed (verb-led, past tense)</dd>
          </div>
          <div class="slice-field">
            <dt>Targets</dt>
            <dd>files modified, comma-separated</dd>
          </div>
          <div class="slice-field">
            <dt>Paths</dt>
            <dd>directories touched</dd>
          </div>
          <div class="slice-field">
            <dt>Gates</dt>
            <dd>doctor gates that ran</dd>
          </div>
          <div class="slice-field">
            <dt>Learnings</dt>
            <dd>discoveries · rules that emerged</dd>
          </div>
          <div class="slice-field">
            <dt>Next actions</dt>
            <dd>follow-ups, queued not assumed</dd>
          </div>
          <div class="slice-field">
            <dt>Reason</dt>
            <dd>why the operator / system requested this slice</dd>
          </div>
        </dl>
        <Fragment slot="outcome">
          Slice-stop = hindsight ingest + approval gate (in strict tier) + audit anchor.
        </Fragment>
      </Workflow>
    </div>
  </section>

  <!-- ── COORDINATOR ──────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 04 · The coordinator primitive</span>
        <h2>Autonomy that's portable across agent CLIs.</h2>
        <p>
          The multi-phase autonomous coordinator is a <strong>Máddu primitive</strong>, not a Claude Code or Codex feature. <span class="verb">maddu coordinator &lt;plan-id&gt;</span> reads a plan, walks the phases, spawns one worker per phase, monitors heartbeats, halts and reports at iteration caps. That's what makes Máddu's autonomy <em>portable</em> across runtimes.
        </p>
      </header>

      <Workflow
        eyebrow="Coordinator sequence"
        title="One worker per phase. Every transition stamps the spine."
        meta="halt-and-report at caps"
        tone="accent"
      >
        <Mermaid
          caption="Coordinator sequence — operator never owns the loop, the spine does"
          aside="runtime-agnostic"
          code={`
sequenceDiagram
    participant Op as Operator
    participant Co as Coordinator
    participant Sp as Spine
    participant W1 as Worker · Phase 1
    participant W2 as Worker · Phase 2
    Op->>Co: maddu coordinator <plan>
    Co->>Sp: COORDINATOR_STARTED
    rect rgba(208, 255, 0, 0.06)
    Note over W1,Sp: Phase 1 · lane A
    Co->>W1: spawn(runtime, phase 1)
    W1->>Sp: SESSION_REGISTERED · LANE_CLAIMED · SLICE_STARTED
    W1-->>Co: heartbeat
    W1->>Sp: SLICE_STOPPED + LANE_RELEASED
    Co->>Sp: COORDINATOR_PHASE_COMPLETED
    end
    rect rgba(86, 184, 255, 0.06)
    Note over W2,Sp: Phase 2 · lane B
    Co->>W2: spawn(runtime, phase 2)
    W2->>Sp: SESSION_REGISTERED · LANE_CLAIMED · SLICE_STARTED
    W2->>Sp: SLICE_STOPPED + LANE_RELEASED
    Co->>Sp: COORDINATOR_PHASE_COMPLETED
    end
    Co->>Sp: COORDINATOR_COMPLETED
    Co-->>Op: halt-and-report
`}
        />
        <Fragment slot="outcome">
          Pause-resume is free: the spine carries the state, not the coordinator process.
        </Fragment>
      </Workflow>
    </div>
  </section>

  <!-- ── ZERO LEARNING CURVE ──────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 05 · The operator surface</span>
        <h2>Zero learning curve, by design.</h2>
      </header>

      <Callout tone="accent" title="The discipline" tag="OMC bar">
        <p>
          The operator never learns CLI flags. Slash commands and natural language go in — <span class="verb">/maddu-autopilot ship X</span>, or simply <em>"fix the bug in Y"</em> — the agent classifies intent and dispatches the right pipeline, then tells the operator which one it picked. The verbose CLI stays available as the scriptable / power-user layer.
        </p>
      </Callout>

      <ul class="dot-list dot-list--2col">
        <li><strong>Slash commands</strong> · 13 on-ramps covering autopilot, plan, review, team, advise, status, cost, skill, help, doctor, cancel, note, suggest</li>
        <li><strong>Natural language</strong> · intent routing maps phrases to pipelines and tells the operator which one it chose</li>
        <li><strong>Verbose CLI</strong> · every verb still callable from a shell — for scripts, hooks, and power users</li>
        <li><strong>Discovery</strong> · <span class="verb">/maddu-help</span> and <span class="verb">maddu suggest</span> remove the "what do I type" gap</li>
      </ul>
    </div>
  </section>

  <PageNext
    eyebrow="§ 06 · Continue"
    title="Architecture — the thirteen layers, one charter."
    hint="Color-coded ontology of the framework. Operator, runtime, execution, substrate, lanes, gauntlet, workers, spine, projections, security, quality, memory, cockpit."
    href="/architecture"
    tone="accent-2"
  />
</Layout>

<style>
  .page-head { padding: var(--m-space-16) 0 var(--m-space-8); }
  .page-head h1 { max-width: 22ch; }
  .lede { font-size: 17px; color: var(--m-fg-0); max-width: 64ch; }
  .dim-h1 { color: var(--m-fg-3); font-weight: 400; }
  .post-eyebrow {
    font-family: var(--m-font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--m-accent);
    margin: var(--m-space-8) 0 var(--m-space-3);
  }

  /* Pipeline cards */
  .pipeline-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--m-space-3);
    margin: 0 0 var(--m-space-6);
  }
  .pipeline-card {
    background: var(--m-bg-2);
    border: 1px solid var(--m-line);
    border-left: 2px solid var(--m-fg-4);
    border-radius: var(--m-radius);
    padding: var(--m-space-4) var(--m-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--m-space-2);
  }
  .pipeline-card--accent    { border-left-color: var(--m-accent); }
  .pipeline-card--accent-2  { border-left-color: var(--m-accent-2); }
  .pipeline-card--warn      { border-left-color: var(--m-warn); }
  .pipeline-card header { display: flex; align-items: baseline; gap: var(--m-space-3); flex-wrap: wrap; }
  .pipeline-num {
    font-family: var(--m-font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--m-fg-3);
  }
  .pipeline-name { margin: 0; font-size: 15px; }
  .pipeline-name code {
    background: transparent;
    color: var(--m-fg-0);
    border: 0;
    padding: 0;
    font-family: var(--m-font-mono);
  }
  .pipeline-tag {
    margin-left: auto;
    font-family: var(--m-font-mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 2px 8px;
    border: 1px solid var(--m-line);
    border-radius: var(--m-radius-pill);
    color: var(--m-fg-3);
  }
  .pipeline-tag--accent { color: var(--m-accent); border-color: var(--m-accent-dim); }
  .pipeline-tag--warn   { color: var(--m-warn); border-color: var(--m-warn-border); }
  .pipeline-tag--accent-2 { color: var(--m-accent-2); border-color: rgba(86, 184, 255, 0.4); }
  .pipeline-when { margin: 0; font-size: 13px; color: var(--m-fg-2); }

  /* Slice-stop field list */
  .slice-fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--m-space-1);
    margin: 0;
  }
  .slice-field {
    background: var(--m-bg-1);
    border: 1px solid var(--m-line-soft);
    border-left: 2px solid var(--m-accent);
    border-radius: var(--m-radius-sm);
    padding: 10px 14px;
  }
  .slice-field dt {
    font-family: var(--m-font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--m-accent);
    margin-bottom: 4px;
  }
  .slice-field dd {
    margin: 0;
    font-size: 12.5px;
    color: var(--m-fg-1);
    font-family: var(--m-font-mono);
  }
</style>
