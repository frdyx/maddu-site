---
import Layout from '../layouts/Layout.astro';
import Callout from '../components/Callout.astro';
import PageNext from '../components/PageNext.astro';
import { AREA_ONE_LINERS } from '../data/area-purposes';
import { SLASH_COMMANDS, AUDIT_CHECKS, DOCTOR_GATES } from '../data/stats';

interface Area {
  id: string;
  title: string;
  glyph: string;
  tone: 'accent' | 'accent-2' | 'warn' | 'danger' | 'ok' | 'framework' | 'session' | 'lane';
  /** The site's 12-second version — one sentence, shown on the card. */
  purpose: string;
  /** The framework's full charter purpose — preserved verbatim behind a disclosure. */
  charter: string;
  verbs: string[];
}

const areas: Area[] = [
  {
    id: 'orchestration',
    title: 'Orchestration core',
    glyph: '◈',
    tone: 'framework',
    purpose: AREA_ONE_LINERS.orchestration,
    charter:
      'Drive the one canonical substrate loop — register a session, claim a lane, run a slice, release. Each transition is one event on the spine. Since v1.93, a lane claim can carry --worktree: an isolated git checkout per lane, so parallel agents never touch each other\'s files while every event still lands on one spine.',
    verbs: ['session', 'register', 'lane', 'slice', 'slice-stop', 'stop', 'worker', 'mailbox'],
  },
  {
    id: 'planning',
    title: 'Planning & autonomy',
    glyph: '↳',
    tone: 'accent',
    purpose: AREA_ONE_LINERS.planning,
    charter:
      'First-class auto-revising planning. Pipelines and goals decompose work — a goal carries measurable success conditions. phase and loop are the iteration primitives — a phase may carry a governance tier (sterile phases escalate discipline for exactly that window, escalation-only; phase clear lifts it). the coordinator fans work across a team. advise and suggest route intent. handoff curates the cross-session "▶ RESUME HERE" briefing.',
    verbs: ['pipeline', 'plan', 'goal', 'phase', 'loop', 'coordinator', 'team', 'advise', 'suggest', 'handoff'],
  },
  {
    id: 'quality',
    title: 'Quality & review',
    glyph: '⚑',
    tone: 'ok',
    purpose: AREA_ONE_LINERS.quality,
    charter:
      'Keep the surface honest. review and test gate slices through host-project test (legacy runner or adaptive profiles). self-test is the framework-source runner. lint and format enforce code hygiene. doctor enforces the 8+1 hard rules on every install and upgrade. architecture gates structural drift between the declared module graph and the real import graph. ci is the headless, LLM-free gate rail — it exits nonzero only on gates the repo pinned as required (ci pin), so framework gate-set churn never changes a consumer\'s CI verdict until they opt in; the same exit code drives a fully-offline git pre-push hook.',
    verbs: ['review', 'test', 'self-test', 'lint', 'format', 'doctor', 'architecture', 'ci'],
  },
  {
    id: 'tools',
    title: 'Default tools',
    glyph: '⌖',
    tone: 'session',
    purpose: AREA_ONE_LINERS.tools,
    charter:
      'The explicit-invocation tool surface an agent reaches for mid-work: version control via git, dependency install, reusable skills, and ad-hoc task tracking.',
    verbs: ['git', 'install', 'skill', 'task'],
  },
  {
    id: 'trust',
    title: 'Supply-chain & trust',
    glyph: '⛨',
    tone: 'danger',
    purpose: AREA_ONE_LINERS.trust,
    charter:
      'The audit / portability / supply-chain posture made operable. trust pins and verifies. sources and approval gate provenance at ingest. governance sets the per-workspace tier. autonomy grades each lane\'s earned trust from the verified record — a Wilson lower bound over witnessed-clean vs dirty slice outcomes — and recommends, never applies, tier changes: the operator decides. mcp brings tools in through allowlisted templates. plugin loads capabilities that live outside the core — bundled-trusted, or user-added and gated by --trust. model governs a domain-specific SLM factory — recording hash-pinned manifests and deriving the promotion ladder from the spine, gating every hand-off but never training, serving, or evaluating.',
    verbs: ['trust', 'sources', 'approval', 'governance', 'autonomy', 'mcp', 'plugin', 'model'],
  },
  {
    id: 'memory',
    title: 'Memory & accounting',
    glyph: '∞',
    tone: 'lane',
    purpose: AREA_ONE_LINERS.memory,
    charter:
      'Make work outlive the agent. memory and hindsight skills persist learning. learn mines past sessions for failed→succeeded tool-call pairs, distilling durable project corrections — and learn sync federates the portable ones across your repos (a lesson recurring in ≥2 repos, or tagged @portable), adopted approval-only and redacted, so a fix learned once propagates across the fleet — plus learn sync --from-claude-memory imports Claude Code\'s own auto-memory as provenance-carrying vendor facts, import-only and content-hash-deduped. blueprint exports a portable, variable-driven handoff of how a whole project was built. debt ledgers the deliberate shortcuts and flags the ones with no upgrade trigger. cost, usage, and the receipt log account for spend — an opt-in cost-budget gate WARNs when recent token spend crosses a ceiling, so a runaway session is visible before it surprises you. import retroactively populates the ledger. evolve is a recommend-only evolution planner — four deterministic detectors over the spine that surface durable corrections and never apply them.',
    verbs: ['memory', 'learn', 'blueprint', 'debt', 'cost', 'usage', 'log', 'import', 'evolve'],
  },
  {
    id: 'discovery',
    title: 'Discovery & observability',
    glyph: '⌕',
    tone: 'accent-2',
    purpose: AREA_ONE_LINERS.discovery,
    charter:
      'Watch and replay the event log. status and events surface live state. spine verifies the append-only truth (never auto-repairs). search and brief query it. orient is the goal-anchored session-start briefing. help is the on-ramp. audit runs the charter-drift check. insights reports, empirically, what is actually used across registered workspaces vs merely defined. fleet is the offline, single-machine view of every Máddu install — version, liveness, and how far behind fleet-latest, computed from each repo on disk without running it (fleet upgrade --plan/--apply stages a snapshot-protected, halt-on-red delivery of updates). focus is the opt-in Focus Director — a domain-blind instrument that tags each turn toward / lateral / away of the declared goal and flags sustained drift (a swap / revert / continue choice, never a gate). export maps the spine to OpenTelemetry logs, read-only — stdout or a collector you name. experience re-reads the spine as normalized trajectories (a pure read-time derivation, zero new events), and experience export is its governed, refuse-on-hit sharing boundary.',
    verbs: ['status', 'events', 'spine', 'search', 'brief', 'orient', 'help', 'audit', 'insights', 'fleet', 'focus', 'export', 'experience'],
  },
  {
    id: 'lifecycle',
    title: 'Lifecycle & plumbing',
    glyph: '⌬',
    tone: 'warn',
    purpose: AREA_ONE_LINERS.lifecycle,
    charter:
      'Operator and script plumbing only (verbose CLI, no slash on-ramp). init, start, and upgrade install and run the spine. agents registers a self-contained "install maddu" stanza into your global agent instruction files, so the framework is reachable by natural language from any future repo. hooks wires Claude Code session hooks into a repo (SessionStart auto-registers + records, SessionEnd closes, PreCompact writes a governance checkpoint before every context compaction) so fresh repos never start building unrecorded. workspace, global, and runtime configure it. schedule fires allowlisted triggers. checkpoint snapshots. auth keeps device-bound tokens. bridges manages live connections.',
    verbs: ['init', 'start', 'upgrade', 'agents', 'hooks', 'workspace', 'global', 'runtime', 'schedule', 'checkpoint', 'auth', 'bridges'],
  },
];

const totalVerbs = areas.reduce((sum, a) => sum + a.verbs.length, 0);
---

<Layout title="Capabilities" pathname="/capabilities">
  <section class="page-head">
    <div class="container">
      <div class="eyebrow-chain">
        <span class="eyebrow">Capabilities</span>
        <span class="eyebrow-sep">·</span>
        <span class="eyebrow-dim">the verb ontology</span>
        <span class="eyebrow-sep">·</span>
        <span class="eyebrow-dim">{areas.length} purpose areas</span>
      </div>
      <h1>Every verb earns its place. <span class="dim-h1">Or it goes.</span></h1>
      <p class="lede">
        {totalVerbs} verbs, {areas.length} purpose areas, one charter that flags drift. Click any verb for its reference page — or expand an area's charter text for the full stated purpose.
      </p>
      <dl class="cap-stats">
        <div><dt>Verbs</dt><dd>{totalVerbs}</dd></div>
        <div><dt>Purpose areas</dt><dd>{areas.length}</dd></div>
        <div><dt>Invariants</dt><dd>9</dd></div>
        <div><dt>Slash on-ramps</dt><dd>{SLASH_COMMANDS}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <div class="cap-filter" role="search">
        <span class="cap-filter-glyph" aria-hidden="true">⌕</span>
        <input
          type="text"
          id="capFilter"
          class="cap-filter-input"
          placeholder="Filter — type a verb, area, or word from a purpose…"
          autocomplete="off"
          spellcheck="false"
          aria-label="Filter capabilities"
        />
        <button class="cap-filter-clear" id="capFilterClear" aria-label="Clear filter" hidden>esc</button>
        <span class="cap-filter-count" id="capFilterCount">{totalVerbs} verbs · {areas.length} areas</span>
      </div>

      <div class="cap-grid" id="capGrid">
        {areas.map((a) => (
          <article
            class:list={['cap-card', `cap-card--${a.tone}`]}
            id={a.id}
            data-area={a.title.toLowerCase()}
            data-purpose={`${a.purpose} ${a.charter}`.toLowerCase()}
            data-verbs={a.verbs.join(' ').toLowerCase()}
          >
            <header class="cap-card-head">
              <span class="cap-glyph" aria-hidden="true">{a.glyph}</span>
              <div class="cap-card-h">
                <h3 class="cap-title">{a.title}</h3>
                <span class="cap-count">{a.verbs.length} verb{a.verbs.length === 1 ? '' : 's'}</span>
              </div>
            </header>
            <p class="cap-purpose">{a.purpose}</p>
            <details class="cap-charter">
              <summary>Full charter purpose</summary>
              <p>{a.charter}</p>
            </details>
            <ul class="cap-verbs">
              {a.verbs.map((v) => (
                <li data-verb={v.toLowerCase()}><a class="cap-verb-link" href={`/capabilities/${v}`}><code>maddu {v}</code></a></li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="cap-empty" id="capEmpty" hidden>
        <span class="cap-empty-glyph" aria-hidden="true">◌</span>
        <p>No verbs or areas match that filter.</p>
        <button class="btn" type="button" id="capEmptyReset">Clear filter</button>
      </div>
    </div>

    <script is:inline>
      (function () {
        const input  = document.getElementById('capFilter');
        const clear  = document.getElementById('capFilterClear');
        const count  = document.getElementById('capFilterCount');
        const grid   = document.getElementById('capGrid');
        const empty  = document.getElementById('capEmpty');
        const reset  = document.getElementById('capEmptyReset');
        if (!input || !grid) return;

        const cards = Array.from(grid.querySelectorAll('.cap-card'));
        const totalVerbs = cards.reduce((n, c) => n + c.querySelectorAll('.cap-verbs li').length, 0);

        function apply(q) {
          q = (q || '').trim().toLowerCase();
          let shownAreas = 0;
          let shownVerbs = 0;

          for (const card of cards) {
            const area    = card.dataset.area || '';
            const purpose = card.dataset.purpose || '';
            const verbs   = card.dataset.verbs || '';
            const verbItems = card.querySelectorAll('.cap-verbs li');

            if (!q) {
              card.hidden = false;
              card.classList.remove('cap-card--dim');
              for (const li of verbItems) li.classList.remove('cap-verb--match', 'cap-verb--dim');
              shownAreas++;
              shownVerbs += verbItems.length;
              continue;
            }

            // Per-verb match check — highlight specific verbs when the query
            // hits one of them, dim the rest. The whole card hides only
            // when nothing inside it matches (area, purpose, or any verb).
            let cardHits = 0;
            for (const li of verbItems) {
              const v = li.dataset.verb || '';
              if (v.indexOf(q) >= 0) {
                li.classList.add('cap-verb--match');
                li.classList.remove('cap-verb--dim');
                cardHits++;
              } else {
                li.classList.remove('cap-verb--match');
                li.classList.add('cap-verb--dim');
              }
            }
            const areaHit    = area.indexOf(q) >= 0;
            const purposeHit = purpose.indexOf(q) >= 0;
            const anyHit     = cardHits > 0 || areaHit || purposeHit;

            card.hidden = !anyHit;
            card.classList.toggle('cap-card--dim', anyHit && cardHits === 0 && (areaHit || purposeHit));
            if (anyHit) {
              shownAreas++;
              shownVerbs += cardHits || verbItems.length;
            }
          }

          if (empty) empty.hidden = shownAreas > 0;
          if (count) {
            count.textContent = q
              ? shownVerbs + ' verb' + (shownVerbs === 1 ? '' : 's') + ' · ' + shownAreas + ' area' + (shownAreas === 1 ? '' : 's')
              : totalVerbs + ' verbs · ' + cards.length + ' areas';
          }
          if (clear) clear.hidden = !q;
        }

        input.addEventListener('input', () => apply(input.value));
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && input.value) {
            e.preventDefault();
            input.value = '';
            apply('');
          }
        });
        const clearFn = () => { input.value = ''; apply(''); input.focus(); };
        clear && clear.addEventListener('click', clearFn);
        reset && reset.addEventListener('click', clearFn);
      })();
    </script>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 02 · How a verb earns its place</span>
        <h2>Four checks. If a verb fails any, the charter flags it.</h2>
      </header>

      <ol class="earn-list">
        <li><strong>Serves the mission</strong> — local-first, auditable orchestration.</li>
        <li><strong>Respects all 9 invariants</strong> — the 8+1 hard rules, no exceptions.</li>
        <li><strong>Reachable from the canonical flow</strong> or an explicit operator/agent surface.</li>
        <li><strong>Traces to a stated purpose</strong> in the charter (the eight areas above).</li>
      </ol>

      <Callout tone="accent" title="maddu audit · 16 coherence self-checks, every release" tag="charter-enforced">
        <p>
          <code>event-types-reachable</code> · <code>command-surface-coherent</code> · <code>cockpit-routes-reachable</code> · <code>docs-indexed</code> · <code>defaults-single-sourced</code> · <code>brief-coherence</code> · <code>architecture-drift</code> · <code>architecture-mass</code> · <code>generated-artifacts-current</code> · <code>slash-on-ramp</code> · <code>charter-drift</code> · <code>rule-gate-traceability</code> · <code>rule-invariant-drift</code> · <code>capability-docs</code> · <code>governance-budget</code> · <code>capability-positioning</code>.
        </p>
        <p>
          Anything that fails is either real drift to fix, or evidence that the charter needs to evolve. The audit's job is to make sure the answer is intentional. Máddu runs this against its own coherence on every release — {AUDIT_CHECKS} self-checks, {DOCTOR_GATES} gates, all green.
        </p>
      </Callout>
    </div>
  </section>

  <PageNext
    eyebrow="§ 03 · Loop back"
    title="Overview — start at the top, with the redesigned hero."
    hint="If you came in deep, the landing page now has the animated substrate loop and the full mental-model summary."
    href="/"
    tone="accent-2"
  />
</Layout>

<style>
  .page-head { padding: var(--m-space-16) 0 var(--m-space-8); }
  .lede { font-size: 17px; color: var(--m-fg-0); max-width: 68ch; }
  .dim-h1 { color: var(--m-fg-3); font-weight: 400; }

  .cap-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--m-space-5);
    border-top: 1px solid var(--m-line-soft);
    padding-top: var(--m-space-5);
    margin: var(--m-space-6) 0 0;
    max-width: 620px;
  }
  .cap-stats div { display: flex; flex-direction: column; gap: 4px; }
  .cap-stats dt {
    font-family: var(--m-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--m-fg-3);
  }
  .cap-stats dd {
    margin: 0;
    font-family: var(--m-font-cond);
    font-weight: 600;
    font-size: 28px;
    color: var(--m-accent);
    line-height: 1;
  }

  /* ── Filter bar ────────────────────────────────────────────────── */
  .cap-filter {
    display: grid;
    grid-template-columns: 24px 1fr auto auto;
    gap: 10px;
    align-items: center;
    padding: 12px 16px;
    background: var(--m-bg-1);
    border: 1px solid var(--m-line);
    border-radius: var(--m-radius);
    margin-bottom: var(--m-space-5);
  }
  .cap-filter-glyph {
    font-family: var(--m-font-mono);
    font-size: 16px;
    color: var(--m-accent);
    text-align: center;
  }
  .cap-filter-input {
    appearance: none;
    background: transparent;
    border: 0;
    outline: 0;
    color: var(--m-fg-0);
    font-family: var(--m-font-sans);
    font-size: 14px;
    padding: 0;
    caret-color: var(--m-accent);
    min-width: 0;
  }
  .cap-filter-input::placeholder { color: var(--m-fg-3); }
  .cap-filter-clear {
    font-family: var(--m-font-mono);
    font-size: 10px;
    color: var(--m-fg-3);
    background: var(--m-bg-2);
    border: 1px solid var(--m-bg-3);
    border-radius: 3px;
    padding: 2px 8px;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .cap-filter-clear:hover { color: var(--m-accent); border-color: var(--m-accent); }
  .cap-filter-count {
    font-family: var(--m-font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--m-fg-3);
    text-transform: uppercase;
  }

  /* Match / dim states */
  .cap-card--dim { opacity: 0.55; }
  .cap-verbs li.cap-verb--match code {
    color: var(--m-accent);
    border-color: var(--m-accent-dim);
    background: color-mix(in srgb, var(--m-accent) 12%, var(--m-bg-3));
  }
  .cap-verbs li.cap-verb--dim { opacity: 0.45; }

  /* Empty state */
  .cap-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--m-space-3);
    padding: var(--m-space-10) var(--m-space-6);
    background: var(--m-bg-2);
    border: 1px dashed var(--m-line);
    border-radius: var(--m-radius);
    color: var(--m-fg-2);
    text-align: center;
  }
  .cap-empty-glyph {
    font-family: var(--m-font-mono);
    font-size: 28px;
    color: var(--m-fg-4);
  }
  .cap-empty p {
    margin: 0;
    font-family: var(--m-font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--m-fg-3);
  }

  .cap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: var(--m-space-3);
  }
  .cap-card {
    background: var(--m-bg-2);
    border: 1px solid var(--m-line);
    border-top: 2px solid var(--m-fg-4);
    border-radius: var(--m-radius);
    padding: var(--m-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--m-space-3);
    transition: border-color 120ms, background 120ms;
  }
  .cap-card:hover { background: var(--m-bg-3); }
  .cap-card-head {
    display: flex;
    align-items: flex-start;
    gap: var(--m-space-3);
  }
  .cap-glyph {
    font-family: var(--m-font-mono);
    font-size: 26px;
    color: var(--m-accent);
    line-height: 1;
  }
  .cap-card-h { flex: 1; }
  .cap-title {
    text-transform: none;
    letter-spacing: 0;
    font-size: 17px;
    color: var(--m-fg-0);
    margin: 0;
    font-family: var(--m-font-cond);
    font-weight: 600;
  }
  .cap-count {
    font-family: var(--m-font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--m-fg-3);
  }
  .cap-purpose {
    color: var(--m-fg-1);
    font-size: 13.5px;
    line-height: 1.55;
    margin: 0;
  }
  .cap-charter { margin: 0; }
  .cap-charter summary {
    cursor: pointer;
    font-family: var(--m-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--m-fg-3);
    user-select: none;
  }
  .cap-charter summary:hover { color: var(--m-accent-2); }
  .cap-charter[open] summary { color: var(--m-accent-2); margin-bottom: var(--m-space-2); }
  .cap-charter p {
    margin: 0;
    color: var(--m-fg-2);
    font-size: 12.5px;
    line-height: 1.6;
    border-left: 2px solid var(--m-line);
    padding-left: var(--m-space-3);
  }
  .cap-verbs {
    list-style: none;
    padding: var(--m-space-3) 0 0;
    margin: 0;
    border-top: 1px solid var(--m-line-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cap-verbs li { margin: 0; }
  .cap-verb-link { text-decoration: none; display: inline-block; }
  .cap-verbs code {
    font-size: 11px;
    background: var(--m-bg-3);
    color: var(--m-fg-0);
    border: 1px solid var(--m-line-soft);
    padding: 3px 8px;
    border-radius: var(--m-radius-sm);
    cursor: pointer;
    transition: border-color 120ms, color 120ms;
  }
  .cap-verb-link:hover code { color: var(--m-accent); border-color: var(--m-accent-dim); }

  /* Tone variants — top border + glyph color */
  .cap-card--accent     { border-top-color: var(--m-accent); }
  .cap-card--accent     .cap-glyph { color: var(--m-accent); }
  .cap-card--accent-2   { border-top-color: var(--m-accent-2); }
  .cap-card--accent-2   .cap-glyph { color: var(--m-accent-2); }
  .cap-card--warn       { border-top-color: var(--m-warn); }
  .cap-card--warn       .cap-glyph { color: var(--m-warn); }
  .cap-card--danger     { border-top-color: var(--m-danger); }
  .cap-card--danger     .cap-glyph { color: var(--m-danger); }
  .cap-card--ok         { border-top-color: var(--m-ok); }
  .cap-card--ok         .cap-glyph { color: var(--m-ok); }
  .cap-card--framework  { border-top-color: var(--m-event-framework); }
  .cap-card--framework  .cap-glyph { color: var(--m-event-framework); }
  .cap-card--session    { border-top-color: var(--m-event-session); }
  .cap-card--session    .cap-glyph { color: var(--m-event-session); }
  .cap-card--lane       { border-top-color: var(--m-event-lane); }
  .cap-card--lane       .cap-glyph { color: var(--m-event-lane); }

  .earn-list { padding-left: 22px; }
  .earn-list li { color: var(--m-fg-1); margin-bottom: 8px; }
</style>
