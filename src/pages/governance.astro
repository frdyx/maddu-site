---
import Layout from '../layouts/Layout.astro';
import Mermaid from '../components/Mermaid.astro';
import Workflow from '../components/Workflow.astro';
import Callout from '../components/Callout.astro';
import Stages from '../components/Stages.astro';
import Legend from '../components/Legend.astro';
import PageNext from '../components/PageNext.astro';

const tiers = [
  {
    name: 'Strict',
    tag: 'consequential',
    tone: 'danger',
    fit: 'Production-adjacent code. Anything billable. Anything you can\'t un-ship in five minutes.',
    rules: [
      'Every mutating action requires explicit operator approval at slice-stop',
      'Cooldowns enforced hard, no override',
      'Worker env allowlist is the only thing workers see',
      'Approval refusal kills the slice immediately',
    ],
  },
  {
    name: 'Standard',
    tag: 'default',
    tone: 'accent',
    fit: 'Most working projects. The right default for daily development.',
    rules: [
      'Allowlist + cooldown enforced',
      'Approval prompted at slice-stops on mutating actions',
      'Operator can pre-approve common patterns',
      'Reasonable friction, no surprises',
    ],
  },
  {
    name: 'Relaxed',
    tag: 'exploration',
    tone: 'accent-2',
    fit: 'Scratch projects, exploration, fast iteration where mistakes are cheap.',
    rules: [
      'Allowlist + cooldown still enforced (structural)',
      'Approval gates skipped at slice-stops',
      'Everything still logged with provenance',
      'Audit trail survives even if real-time gating doesn\'t',
    ],
  },
];
---

<Layout title="Governance" pathname="/governance">
  <section class="page-head">
    <div class="container">
      <div class="eyebrow-chain">
        <span class="eyebrow">Governance</span>
        <span class="eyebrow-sep">·</span>
        <span class="eyebrow-dim">discipline that scales with consequence</span>
        <span class="eyebrow-sep">·</span>
        <span class="eyebrow-dim">3 tiers</span>
      </div>
      <h1>The gauntlet, and three tiers that fit it.</h1>
      <p class="lede">
        A scratch web app shouldn't drown in approval friction. A consequential system shouldn't get to skip them. Máddu's governance lets the same framework hold both, by making operational discipline a per-workspace dial — without ever touching the structural invariants.
      </p>
    </div>
  </section>

  <!-- ── THE GAUNTLET ─────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 01 · The gauntlet</span>
        <h2>Every state-mutating auto-trigger walks this.</h2>
        <p>The gauntlet — allowlist, then cooldown, then tier check — is the brake on the failure mode where an agent confidently propagates a wrong call across handoffs with nothing to stop it.</p>
      </header>

      <Workflow
        eyebrow="Rule #9 · permanent since v0.19.0"
        title="action → allowlist → cooldown → tier → fire"
        subtitle="Read-only passes through (still logged). Mutating actions walk every gate."
        meta="4 gates · 1 provenance"
        tone="warn"
      >
        <Stages
          stages={[
            { label: 'tier check',  sub: 'read-only?', tone: 'accent-2' },
            { label: 'allowlist',   sub: 'triggers.json', tone: 'accent' },
            { label: 'cooldown',    sub: 'respected?', tone: 'accent' },
            { label: 'tier',        sub: 'strict/std/relaxed', tone: 'warn' },
            { label: 'fire',        sub: '+ provenance', tone: 'ok' },
          ]}
          numbered
        />
        <Mermaid
          caption="The gauntlet flow · gates yellow, refusal red, fire green"
          code={`
flowchart TD
    A[action proposed]:::neutral --> B{tier?}:::gate
    B -->|read-only| PASS[pass-through<br/>still logged as event]:::accent2
    B -->|mutating| C{on triggers.json<br/>allowlist?}:::gate
    C -->|no| REJ[refuse<br/>APPROVAL_REQUESTED event]:::refuse
    C -->|yes| D{cooldown<br/>respected?}:::gate
    D -->|no| REJ
    D -->|yes| E{governance tier}:::gate
    E -->|strict| F1[operator approval required]:::danger
    E -->|standard| F2[conditional · slice-stop check]:::warn
    E -->|relaxed| F3[auto-fire allowed]:::accent2
    F1 --> FIRE
    F2 --> FIRE
    F3 --> FIRE
    FIRE[TRIGGER_FIRED event<br/>+ triggered_by provenance]:::ok
`}
        />
        <Fragment slot="outcome">
          Every mutating action ends up on the spine, with or without operator approval upstream.
        </Fragment>
      </Workflow>
      <Legend
        label="Color key"
        items={[
          { tone: 'neutral',  label: 'proposed action' },
          { tone: 'gate',     label: 'gauntlet · decision gate' },
          { tone: 'accent2',  label: 'read-only · pass-through' },
          { tone: 'refuse',   label: 'refusal · APPROVAL_REQUESTED' },
          { tone: 'danger',   label: 'strict · operator approval required' },
          { tone: 'warn',     label: 'standard · conditional' },
          { tone: 'ok',       label: 'fire · TRIGGER_FIRED' },
        ]}
      />
    </div>
  </section>

  <!-- ── TIERS ────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 02 · The three tiers</span>
        <h2>Per-workspace dial. Switch with one slash command.</h2>
        <p>Set in <code>.maddu/config/governance.json</code>. The cockpit shows the current tier prominently so the operator never forgets which posture they're in. <span class="verb">/maddu-governance &lt;mode&gt;</span> switches with an audit event.</p>
      </header>

      <div class="tier-grid">
        {tiers.map((t, i) => (
          <article class:list={['tier-card', `tier-card--${t.tone}`]}>
            <header>
              <span class="tier-n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <span class="tier-tag">tier · {t.tag}</span>
                <h3>{t.name}</h3>
              </div>
            </header>
            <ul class="tier-rules">
              {t.rules.map((r) => <li>{r}</li>)}
            </ul>
            <footer class="tier-fit">
              <span class="tier-fit-label">Fit</span>
              <span class="tier-fit-body">{t.fit}</span>
            </footer>
          </article>
        ))}
      </div>

      <Callout tone="warn" title="What never changes across tiers" tag="structural integrity">
        <p>
          The 8+1 hard rules stay immutable. Files-only state, append-only spine, no hosted backend, no broad new deps, no provider SDKs in app code, no token export, brand boundary, lane ownership, the gauntlet itself.
        </p>
        <p>
          Tiers tune <em>operational</em> friction. They never loosen <em>structural</em> integrity.
        </p>
      </Callout>
    </div>
  </section>

  <!-- ── SLICE-STOP ───────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 03 · Slice-stop as governance ritual</span>
        <h2>Where the approval gate actually runs.</h2>
        <p>Every working slice ends at a slice-stop. That's not just a memo to the spine — in strict and standard tiers, it's where the gauntlet's approval gate runs. The structured form makes operator approval <em>cheap</em>: enough on the screen to make an informed call without reading the diff.</p>
      </header>

      <Workflow
        eyebrow="Approval sequence"
        title="Logged on both sides — granted or denied."
        subtitle="Replay reconstructs the full approval history deterministically."
        meta="spine-anchored"
        tone="accent"
      >
        <Mermaid
          caption="An approval, end-to-end · green path = granted, red path = denied"
          code={`
sequenceDiagram
    participant W as Worker
    participant Gt as Gauntlet
    participant Op as Operator
    participant Sp as Spine
    W->>Gt: propose mutating action
    Gt->>Sp: APPROVAL_REQUESTED (tool, args-shape, why)
    Gt-->>Op: cockpit · approval card
    alt approved
        rect rgba(97, 211, 148, 0.08)
        Note over Op,Sp: granted path
        Op->>Gt: allow
        Gt->>Sp: APPROVAL_GRANTED
        Gt->>W: proceed
        W->>Sp: TRIGGER_FIRED + triggered_by
        end
    else denied
        rect rgba(255, 94, 122, 0.08)
        Note over Op,Sp: denied path
        Op->>Gt: deny
        Gt->>Sp: APPROVAL_DENIED
        Gt->>W: refuse · slice closes
        end
    end
`}
        />
        <Fragment slot="outcome">
          A relaxed-tier workspace skips real-time gating, but the audit ledger reads the same way at the end.
        </Fragment>
      </Workflow>
    </div>
  </section>

  <!-- ── LANE OWNERSHIP ───────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 04 · Lane ownership</span>
        <h2>The concurrency half of governance.</h2>
      </header>

      <Callout tone="accent" title="Rule #8 — bounded blast radius" tag="concurrency without locks">
        <p>
          Two agents can't hold the same lane. Cross-lane work goes through a mailbox NDJSON, never shared mutation. Force-claims leave a <code>contested-claim</code> audit. This bounds the blast radius of any single agent's mistake to one file area at a time.
        </p>
      </Callout>
    </div>
  </section>

  <PageNext
    eyebrow="§ 05 · Continue"
    title="Hard rules — the 8+1 invariants in full."
    hint="What they mean, what enforces them, and what's deliberately absent because of them."
    href="/hard-rules"
    tone="brand"
  />
</Layout>

<style>
  .page-head { padding: var(--m-space-16) 0 var(--m-space-8); }
  .lede { font-size: 17px; color: var(--m-fg-0); max-width: 64ch; }

  .tier-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--m-space-3);
    margin: 0 0 var(--m-space-5);
  }
  .tier-card {
    background: var(--m-bg-2);
    border: 1px solid var(--m-line);
    border-top: 2px solid var(--m-fg-4);
    border-radius: var(--m-radius);
    padding: var(--m-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--m-space-3);
  }
  .tier-card header { display: flex; align-items: baseline; gap: var(--m-space-3); }
  .tier-n {
    font-family: var(--m-font-cond);
    font-weight: 700;
    font-size: 30px;
    color: var(--m-fg-3);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .tier-tag {
    display: block;
    font-family: var(--m-font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--m-fg-3);
    margin-bottom: 4px;
  }
  .tier-card h3 {
    margin: 0;
    text-transform: none;
    letter-spacing: 0;
    font-size: 22px;
    color: var(--m-fg-0);
    font-family: var(--m-font-cond);
    font-weight: 600;
  }
  .tier-rules {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 4px;
  }
  .tier-rules li {
    position: relative;
    padding-left: 18px;
    font-size: 12.5px;
    color: var(--m-fg-1);
    line-height: 1.5;
  }
  .tier-rules li::before {
    content: '◦';
    position: absolute;
    left: 0;
    color: currentColor;
    opacity: 0.6;
  }
  .tier-fit {
    margin-top: auto;
    padding-top: var(--m-space-3);
    border-top: 1px solid var(--m-line-soft);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tier-fit-label {
    font-family: var(--m-font-mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--m-fg-3);
  }
  .tier-fit-body { font-size: 12px; color: var(--m-fg-1); font-style: italic; }

  .tier-card--danger    { border-top-color: var(--m-danger); }
  .tier-card--danger    .tier-tag,
  .tier-card--danger    .tier-n,
  .tier-card--danger    .tier-rules li::before { color: var(--m-danger); }
  .tier-card--accent    { border-top-color: var(--m-accent); }
  .tier-card--accent    .tier-tag,
  .tier-card--accent    .tier-n,
  .tier-card--accent    .tier-rules li::before { color: var(--m-accent); }
  .tier-card--accent-2  { border-top-color: var(--m-accent-2); }
  .tier-card--accent-2  .tier-tag,
  .tier-card--accent-2  .tier-n,
  .tier-card--accent-2  .tier-rules li::before { color: var(--m-accent-2); }
</style>
