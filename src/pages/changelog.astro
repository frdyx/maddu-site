// Release → the docs page that documents what it shipped. Keyed by release id;
// entries without a clear docs home simply carry no link. Add more as docs grow.
const ARC_WEEKS = Math.round(
  (Math.max(...RELEASES.map((r) => Date.parse(r.date))) - Math.min(...RELEASES.map((r) => Date.parse(r.date)))) / 6048e5,
);

const DOCS_LINKS: Record<string, { href: string; label: string }> = {
  'v1-151-0': { href: '/docs/reference/embedded-runtime', label: 'Embedding Máddu in a product' },
  'v1-140-0': { href: '/docs/reference/product-runtime-rfc', label: 'The product-runtime RFC' },
  'v1-123-0': { href: '/docs/reference/runtimes-and-mcp', label: 'Runtimes & MCP' },
  'v1-121-0': { href: '/docs/reference/acceptance-proof', label: 'Acceptance proofs' },
  'v1-96-0': { href: '/docs/security',            label: 'Security' },
  'v1-95-0': { href: '/docs/capabilities',        label: 'Verbs · maddu model' },
  'v1-94-0': { href: '/docs/capabilities',        label: 'Verbs · experience / evolve' },
  'v1-93-0': { href: '/docs/architecture',        label: 'Architecture · lanes' },
  'v1-92-0': { href: '/docs/features/autonomy',   label: 'Earned autonomy' },
  'v1-91-0': { href: '/docs/governance',          label: 'Governance · phase tiers' },
  'v1-89-0': { href: '/docs/features/discipline', label: 'Session discipline' },
  'v1-87-0': { href: '/docs/features',            label: 'Features · governance in CI' },
  'v1-86-0': { href: '/docs/features/cost',       label: 'Cost & budget' },
  'v1-85-0': { href: '/docs/features',            label: 'Features · failure learning' },
};

const indexItems = RELEASES.map((r) => ({
  n: r.version,
  id: r.id,
  tone:
    r.type === 'milestone' ? 'brand' :
    r.type === 'feature' ? 'accent' :
    r.type === 'hardening' ? 'danger' :
    r.type === 'polish' ? 'accent-2' :
    'warn',
  label: r.headline,
}));

function typeMeta(t: ReleaseType) {
  switch (t) {
    case 'milestone': return { tone: 'brand', label: 'milestone' };
    case 'feature':   return { tone: 'accent', label: 'feature' };
    case 'hardening': return { tone: 'danger', label: 'hardening' };
    case 'polish':    return { tone: 'accent-2', label: 'polish' };
    case 'patch':     return { tone: 'warn', label: 'patch' };
  }
}
---

<Layout title="Changelog" pathname="/changelog">
  <section class="page-head">
    <div class="container">
      <div class="eyebrow-chain">
        <span class="eyebrow">Changelog</span>
        <span class="eyebrow-sep">·</span>
        <span class="eyebrow-dim">v0.17.1 → v1.115.0</span>
        <span class="eyebrow-sep">·</span>
        <span class="eyebrow-dim">{RELEASES.length} releases · ~{ARC_WEEKS} weeks</span>
      </div>
      <h1>{RELEASES.length} releases. <span class="dim-h1">One charter held.</span></h1>
      <p class="lede">
        The arc that took Máddu from a private 18-gate baseline to v{VERSION}. A tamper-detecting spine, failure learning, portable blueprints, architecture-drift detection, the offline fleet view, the headless <code>maddu ci</code> gate rail, sterile phases, earned autonomy, worktree lanes, acceptance proofs, an embeddable product runtime. Every release grew the doctor from 18 to {DOCTOR_GATES} gates — and never broke a posted invariant. Color-coded by release type.
      </p>

      <dl class="cl-stats">
        <div><dt>Releases</dt><dd>{RELEASES.length}</dd></div>
        <div><dt>Doctor gates added</dt><dd>+{DOCTOR_GATES - 18}</dd></div>
        <div><dt>Audit self-checks</dt><dd>{AUDIT_CHECKS}</dd></div>
        <div><dt>Invariants broken</dt><dd>0</dd></div>
      </dl>

      <ul class="cl-legend">
        <li><span class="cl-dot cl-dot--brand"></span> Milestone</li>
        <li><span class="cl-dot cl-dot--accent"></span> Feature</li>
        <li><span class="cl-dot cl-dot--danger"></span> Hardening</li>
        <li><span class="cl-dot cl-dot--accent-2"></span> Polish</li>
        <li><span class="cl-dot cl-dot--warn"></span> Patch</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <div class="cl-layout">
        <div class="cl-releases">
          {RELEASES.map((r) => {
            const meta = typeMeta(r.type);
            return (
              <article class:list={['cl-release', `cl-release--${meta.tone}`]} id={r.id}>
                <header class="cl-head">
                  <div class="cl-head-row">
                    <span class="cl-version">{r.version}</span>
                    <span class:list={['cl-type', `cl-type--${meta.tone}`]}>{meta.label}</span>
                    <span class="cl-date">{r.date}</span>
                  </div>
                  <h3 class="cl-headline">{r.headline}</h3>
                </header>
                {r.highlights && r.highlights.length > 0 ? (
                  <ul class="cl-highlights">
                    {r.highlights.map((h) => <li set:html={h.replace(/`([^`]+)`/g, '<code>$1</code>').replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')}></li>)}
                  </ul>
                ) : r.summary ? (
                  <p class="cl-summary" set:html={r.summary.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/`([^`]+)`/g, '<code>$1</code>').replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')}></p>
                ) : null}
                {r.note && (
                  <p class="cl-note">{r.note}</p>
                )}
                {DOCS_LINKS[r.id] && (
                  <p class="cl-docs">
                    <span class="cl-docs-label">In the docs</span>
                    <a href={DOCS_LINKS[r.id].href}>{DOCS_LINKS[r.id].label} <span aria-hidden="true">&rarr;</span></a>
                  </p>
                )}
              </article>
            );
          })}
        </div>
        <TocIndex
          eyebrow={`Releases · ${RELEASES.length}`}
          items={indexItems}
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Callout tone="ok" title="What never moved" tag="charter discipline">
        <p>
          Every release across this arc kept the layout-refusal gate at 4/4. The 8+1 hard rules graduated from "architectural" to "doctor-enforced" without a single rule ever loosening. The spine format, the slash names, the cockpit routes, the CLI surface, the marker discipline — all stable since v1.0.0.
        </p>
        <p>
          The lesson: invariants you can't change become invariants you don't have to argue about. Velocity comes from the freedom <em>around</em> them, not from negotiating <em>them</em>.
        </p>
      </Callout>
    </div>
  </section>

  <PageNext
    eyebrow="§ · Continue"
    title="Install — one command, audited from the first event."
    hint="npx github:frdyx/maddu init, then maddu doctor proves the install. The repo is public."
    href="/install"
    tone="accent"
  />
</Layout>

<style>
  .page-head { padding: var(--m-space-16) 0 var(--m-space-8); }
  .lede { font-size: 17px; color: var(--m-fg-0); max-width: 70ch; }
  .dim-h1 { color: var(--m-fg-3); font-weight: 400; }

  .cl-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--m-space-5);
    border-top: 1px solid var(--m-line-soft);
    padding-top: var(--m-space-5);
    margin: var(--m-space-6) 0 var(--m-space-5);
    max-width: 720px;
  }
  .cl-stats div { display: flex; flex-direction: column; gap: 4px; }
  .cl-stats dt {
    font-family: var(--m-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--m-fg-3);
  }
  .cl-stats dd {
    margin: 0;
    font-family: var(--m-font-cond);
    font-weight: 600;
    font-size: 28px;
    color: var(--m-accent);
    line-height: 1;
  }

  /* Legend */
  .cl-legend {
    display: flex;
    gap: var(--m-space-4);
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--m-font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--m-fg-3);
  }
  .cl-legend li { display: flex; align-items: center; gap: 6px; }
  .cl-dot {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    border: 1px solid currentColor;
    background: currentColor;
    flex-shrink: 0;
  }
  .cl-dot--brand    { color: var(--m-brand); }
  .cl-dot--accent   { color: var(--m-accent); }
  .cl-dot--danger   { color: var(--m-danger); }
  .cl-dot--accent-2 { color: var(--m-accent-2); }
  .cl-dot--warn     { color: var(--m-warn); }

  /* Two-col layout with sticky TOC */
  .cl-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--m-space-6);
    align-items: start;
  }
  @media (max-width: 920px) {
    .cl-layout { grid-template-columns: minmax(0, 1fr); }
    .cl-layout > :global(.toc) { display: none; }
  }
  .cl-releases { display: flex; flex-direction: column; gap: var(--m-space-4); min-width: 0; }

  /* Release card */
  .cl-release {
    background: var(--m-bg-2);
    border: 1px solid var(--m-line);
    border-left: 2px solid var(--m-fg-4);
    border-radius: var(--m-radius);
    padding: var(--m-space-5) var(--m-space-6);
    scroll-margin-top: 80px;
  }
  .cl-release--brand    { border-left-color: var(--m-brand); }
  .cl-release--accent   { border-left-color: var(--m-accent); }
  .cl-release--danger   { border-left-color: var(--m-danger); }
  .cl-release--accent-2 { border-left-color: var(--m-accent-2); }
  .cl-release--warn     { border-left-color: var(--m-warn); }

  .cl-head { margin-bottom: var(--m-space-3); }
  .cl-head-row {
    display: flex;
    align-items: baseline;
    gap: var(--m-space-3);
    flex-wrap: wrap;
    margin-bottom: 6px;
  }
  .cl-version {
    font-family: var(--m-font-mono);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--m-fg-0);
  }
  .cl-release--brand    .cl-version { color: var(--m-brand); }
  .cl-release--accent   .cl-version { color: var(--m-accent); }
  .cl-release--danger   .cl-version { color: var(--m-danger); }
  .cl-release--accent-2 .cl-version { color: var(--m-accent-2); }
  .cl-release--warn     .cl-version { color: var(--m-warn); }

  .cl-type {
    font-family: var(--m-font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 2px 8px;
    border: 1px solid var(--m-line);
    border-radius: var(--m-radius-pill);
    color: var(--m-fg-3);
  }
  .cl-type--brand    { color: var(--m-brand);    border-color: rgba(240, 78, 35, 0.4); }
  .cl-type--accent   { color: var(--m-accent);   border-color: var(--m-accent-dim); }
  .cl-type--danger   { color: var(--m-danger);   border-color: var(--m-danger-border); }
  .cl-type--accent-2 { color: var(--m-accent-2); border-color: rgba(86, 184, 255, 0.4); }
  .cl-type--warn     { color: var(--m-warn);     border-color: var(--m-warn-border); }

  .cl-date {
    margin-left: auto;
    font-family: var(--m-font-mono);
    font-size: 11px;
    color: var(--m-fg-3);
    letter-spacing: 0.04em;
  }

  .cl-headline {
    margin: 0;
    text-transform: none;
    letter-spacing: 0;
    font-size: 20px;
    color: var(--m-fg-0);
    font-family: var(--m-font-cond);
    font-weight: 600;
  }

  .cl-highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
  }
  .cl-highlights li {
    position: relative;
    padding-left: 22px;
    color: var(--m-fg-1);
    font-size: 13.5px;
    line-height: 1.55;
  }
  .cl-highlights li::before {
    content: '◦';
    position: absolute;
    left: 0;
    color: var(--m-accent);
    font-family: var(--m-font-mono);
  }
  .cl-release--brand    .cl-highlights li::before { color: var(--m-brand); }
  .cl-release--danger   .cl-highlights li::before { color: var(--m-danger); }
  .cl-release--accent-2 .cl-highlights li::before { color: var(--m-accent-2); }
  .cl-release--warn     .cl-highlights li::before { color: var(--m-warn); }

  .cl-summary {
    margin: 0;
    color: var(--m-fg-1);
    font-size: 13.5px;
    line-height: 1.6;
  }

  .cl-note {
    margin: var(--m-space-3) 0 0;
    padding: var(--m-space-3) var(--m-space-4);
    background: var(--m-bg-1);
    border-left: 2px solid var(--m-fg-4);
    border-radius: var(--m-radius-sm);
    font-size: 13px;
    color: var(--m-fg-2);
    font-style: italic;
    max-width: none;
  }
  .cl-release--brand    .cl-note { border-left-color: var(--m-brand); }
  .cl-release--accent   .cl-note { border-left-color: var(--m-accent); }
  .cl-release--danger   .cl-note { border-left-color: var(--m-danger); }
  .cl-release--accent-2 .cl-note { border-left-color: var(--m-accent-2); }
  .cl-release--warn     .cl-note { border-left-color: var(--m-warn); }

  /* Link from a release to the docs page that documents it. */
  .cl-docs {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: var(--m-space-3) 0 0;
    font-size: 12.5px;
  }
  .cl-docs-label {
    font-family: var(--m-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--m-fg-4);
  }
  .cl-docs a {
    color: var(--m-accent-2);
    border-bottom: 1px solid transparent;
  }
  .cl-docs a:hover { color: var(--m-accent); border-bottom-color: var(--m-accent-dim); }
</style>
