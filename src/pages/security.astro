---
import Layout from '../layouts/Layout.astro';
import Mermaid from '../components/Mermaid.astro';
import Workflow from '../components/Workflow.astro';
import Callout from '../components/Callout.astro';
import Annotated from '../components/Annotated.astro';
import Legend from '../components/Legend.astro';
import PageNext from '../components/PageNext.astro';

interface Defense {
  n: string;
  tone: 'accent' | 'accent-2' | 'warn' | 'danger' | 'ok' | 'brand';
  title: string;
  body: string;
  where: string;
}

const defenses: Defense[] = [
  {
    n: '01',
    tone: 'accent',
    title: 'Worker subprocess isolation',
    body: 'Every provider call lives in a subprocess worker. The framework itself never imports an SDK. Rule #5, layout-refusal kills doctor if an SDK shows up in app code.',
    where: 'app code: clean · workers: own the SDK',
  },
  {
    n: '02',
    tone: 'accent-2',
    title: 'Worker env allowlist (default-deny)',
    body: 'Spawned workers don\'t inherit your shell. Secret-keyed env vars (*_TOKEN, *_KEY, *_SECRET, provider-specific patterns) are stripped at spawn unless explicitly allowed.',
    where: '.maddu/config/governance.json',
  },
  {
    n: '03',
    tone: 'warn',
    title: 'Secret scan on tool argv',
    body: 'Tool arguments pass a pattern scanner before any logging: AWS, OpenAI, Anthropic, GitHub, GitLab, Slack token shapes are detected and blocked. Raw values are never logged — only a SECRET_SCAN_BLOCKED event with the pattern name.',
    where: 'spine event · SECRET_SCAN_BLOCKED',
  },
  {
    n: '04',
    tone: 'brand',
    title: 'Device-bound OAuth tokens',
    body: 'Tokens live in OS keystore paths: ~/.config/maddu/auth/ on Linux/macOS, %APPDATA%\\maddu\\auth\\ on Windows. No cross-machine sync, by design. Rule #6.',
    where: 'never in .maddu/ · never in git',
  },
  {
    n: '05',
    tone: 'accent',
    title: 'Supply-chain pinning',
    body: 'maddu trust audit / pin / verify pins every dependency with SHA256 provenance. Re-verification on every install and upgrade. dependency-freshness and dep-pinning-respected gates fail doctor on tamper.',
    where: '.maddu/trust/* · sha256 ledger',
  },
  {
    n: '06',
    tone: 'accent-2',
    title: 'MCP gallery — allowlist-only ingress',
    body: 'MCP servers come from a curated template gallery shipping JSON descriptors with SHA256 provenance. Operator installs via maddu mcp install <template>. Anything else is refused.',
    where: 'template/maddu/mcp-templates/',
  },
  {
    n: '07',
    tone: 'danger',
    title: 'The gauntlet (rule #9)',
    body: 'The behavioral defense, not the structural one. Anything that mutates state must be allowlisted, must respect its cooldown, must satisfy the active governance tier, and must leave a provenance-stamped event. Prevents confidently-wrong, unsupervised propagation.',
    where: 'spine event · TRIGGER_FIRED + triggered_by',
  },
];
---

<Layout title="Security" pathname="/security">
  <section class="page-head">
    <div class="container">
      <div class="eyebrow-chain">
        <span class="eyebrow">Security</span>
        <span class="eyebrow-sep">·</span>
        <span class="eyebrow-dim">structural, not advisory</span>
        <span class="eyebrow-sep">·</span>
        <span class="eyebrow-dim">7 enforcement points</span>
      </div>
      <h1>Security is <em>structural</em> here. <span class="dim-h1">Not advisory.</span></h1>
      <p class="lede">
        Most agent stacks treat security as a layer you add. Máddu makes the posture load-bearing — if the rules don't hold, doctor refuses to start. There's no "secure mode" toggle, because there's no other mode.
      </p>
    </div>
  </section>

  <!-- ── THREAT MAP ──────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 01 · Threat model</span>
        <h2>Where the security boundaries actually live.</h2>
        <p>Five places an agent stack typically leaks: secrets in env vars, secrets in tool arguments, tokens in transit, supply-chain compromise via deps or MCP tools, and unbounded propagation of a wrong action. Máddu addresses each at the layer it actually occurs.</p>
      </header>

      <Workflow
        eyebrow="Boundary map"
        title="Spawn boundary is the load-bearing line."
        subtitle="Everything past it is a worker subprocess. Everything before it is framework code that never touches a provider SDK."
        meta="5 surfaces · 5 enforcement points"
        tone="danger"
      >
        <Mermaid
          caption="Where every secret, token, and dep is gated · color-coded by enforcement type"
          aside="5 surfaces"
          code={`
flowchart LR
    AGENT[Agent CLI]:::session -->|spawns| W[Worker subprocess]:::worker
    subgraph BORDER["Spawn boundary — every provider call lives past this line"]
        W
    end
    OS[(OS keystore<br/>device-bound)]:::brand -.creds at spawn.-> W
    W -->|tool argv| SCAN[/secret-scan/]:::danger
    SCAN -.blocked patterns.-> SPINE[(spine event<br/>SECRET_SCAN_BLOCKED)]:::spine
    SCAN -->|sanitized| TOOL[external tool / MCP]:::accent2
    ENV[env allowlist<br/>default-deny]:::danger --> W
    DEPS[maddu trust<br/>SHA256 pinned]:::accent --> W
    MCP[MCP gallery<br/>allowlisted only]:::accent2 --> W
    W -->|usage events| SPINE
    GAUNT{gauntlet:<br/>allowlist + cooldown<br/>+ tier}:::gate --> W
`}
        />
        <Fragment slot="outcome">
          Nothing leaves the machine. Nothing logs raw secrets. Everything mutating gates through #9.
        </Fragment>
      </Workflow>
      <Legend
        label="Color key"
        items={[
          { tone: 'session',  label: 'agent CLI' },
          { tone: 'worker',   label: 'worker subprocess · load-bearing' },
          { tone: 'brand',    label: 'OS keystore · device-bound' },
          { tone: 'danger',   label: 'secret scan · env allowlist' },
          { tone: 'accent',   label: 'maddu trust · SHA256 pinning' },
          { tone: 'accent2',  label: 'sanitized output · MCP gallery' },
          { tone: 'gate',     label: 'gauntlet' },
          { tone: 'spine',    label: 'spine event' },
        ]}
      />
    </div>
  </section>

  <!-- ── DEFENSES ────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 02 · Defenses</span>
        <h2>Seven structural enforcement points.</h2>
        <p>Each maps to a brand-tone so you can scan the page: lime = invariant, blue = supply chain, yellow = behavioral, red = blast-radius bound, orange = device-bound.</p>
      </header>

      <div class="def-grid">
        {defenses.map((d) => (
          <article class:list={['def-card', `def-card--${d.tone}`]}>
            <header>
              <span class="def-n">{d.n}</span>
              <h3>{d.title}</h3>
            </header>
            <p class="def-body">{d.body}</p>
            <code class="def-where">{d.where}</code>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FORBIDDEN PATTERNS ──────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 03 · What's explicitly forbidden</span>
        <h2>The patterns this framework refuses to implement.</h2>
        <p>These aren't TODOs. They're named, refused, and structurally impossible inside the charter.</p>
      </header>

      <div class="grid-2">
        <Callout tone="danger" title="The Hermes pattern" tag="never going to be built">
          <p>
            A hosted webhook holding many users' bot tokens, accepting inbound commands. The exact failure mode where one breach cascades across every connected operator.
          </p>
          <p>
            Chat and connector integrations are allowed <em>only</em> if local, direct-API, device-bound token, off-by-default, allowlisted, and never inbound-as-command.
          </p>
        </Callout>
        <Callout tone="danger" title="Auto-repair of the spine" tag="rule #2 corollary">
          <p>
            Spine corruption is never silently fixed. <code>maddu spine verify</code> detects, surfaces, and stops. The operator reads the failure and decides.
          </p>
          <p>
            A system that quietly heals itself is a system that can quietly hide a successful attack.
          </p>
        </Callout>
      </div>
    </div>
  </section>

  <!-- ── BOUNDARY ─────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 04 · The boundary</span>
        <h2>What you still have to do yourself.</h2>
      </header>

      <Callout tone="warn" title="Máddu is the posture layer" tag="not a vault">
        <p>
          Máddu is the audit and posture layer. It is <strong>not</strong> a secret store, a vault, or a key rotator. Pair it with a real vault (Hashicorp, AWS Secrets Manager, Cloudflare Secrets, 1Password Connect — pick one). Use least-privilege IAM. Rotate keys.
        </p>
        <p>
          Máddu's job is to make sure your agents don't leak what's in those stores. It's not the store itself.
        </p>
      </Callout>

      <h2>The operator's manual</h2>
      <p>
        The full threat model lives in the framework repo at <code>docs/34-threat-model.md</code>. It enumerates every assumed attack surface, the structural defense at that layer, the residual risk, and the operator action required (if any). Read it before you put Máddu in front of anything consequential.
      </p>

      <p class="cta-row">
        <a class="btn btn-primary" href="/threat-model">Open the full threat model <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <PageNext
    eyebrow="§ 05 · Continue"
    title="Governance — the gauntlet and three tiers that fit it."
    hint="Discipline that scales with consequence. Strict, standard, relaxed — what changes between them, what never does."
    href="/governance"
    tone="warn"
  />
</Layout>

<style>
  .page-head { padding: var(--m-space-16) 0 var(--m-space-8); }
  .lede { font-size: 17px; color: var(--m-fg-0); max-width: 64ch; }
  .dim-h1 { color: var(--m-fg-3); font-weight: 400; }

  .def-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--m-space-3);
    margin: 0;
  }
  .def-card {
    background: var(--m-bg-2);
    border: 1px solid var(--m-line);
    border-top: 2px solid var(--m-fg-4);
    border-radius: var(--m-radius);
    padding: var(--m-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--m-space-3);
    transition: border-color 120ms, background 120ms, box-shadow 120ms;
  }
  .def-card:hover { background: var(--m-bg-3); }
  .def-card header { display: flex; align-items: baseline; gap: var(--m-space-3); }
  .def-n {
    font-family: var(--m-font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--m-fg-3);
    padding: 2px 8px;
    border: 1px solid var(--m-line);
    border-radius: var(--m-radius-pill);
  }
  .def-card h3 {
    text-transform: none;
    letter-spacing: 0;
    font-size: 16px;
    color: var(--m-fg-0);
    margin: 0;
    font-family: var(--m-font-cond);
    font-weight: 600;
  }
  .def-body {
    margin: 0;
    font-size: 13.5px;
    color: var(--m-fg-1);
    line-height: 1.55;
  }
  .def-where {
    align-self: flex-start;
    background: var(--m-bg-3);
    color: var(--m-accent-2);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    padding: 3px 10px;
    border: 1px solid var(--m-line-soft);
    border-radius: var(--m-radius-sm);
    font-family: var(--m-font-mono);
  }

  .def-card--accent     { border-top-color: var(--m-accent); }
  .def-card--accent     .def-n { color: var(--m-accent); border-color: var(--m-accent-dim); }
  .def-card--accent-2   { border-top-color: var(--m-accent-2); }
  .def-card--accent-2   .def-n { color: var(--m-accent-2); border-color: rgba(86, 184, 255, 0.4); }
  .def-card--warn       { border-top-color: var(--m-warn); }
  .def-card--warn       .def-n { color: var(--m-warn); border-color: var(--m-warn-border); }
  .def-card--danger     { border-top-color: var(--m-danger); }
  .def-card--danger     .def-n { color: var(--m-danger); border-color: var(--m-danger-border); }
  .def-card--ok         { border-top-color: var(--m-ok); }
  .def-card--ok         .def-n { color: var(--m-ok); border-color: var(--m-ok-border); }
  .def-card--brand      { border-top-color: var(--m-brand); }
  .def-card--brand      .def-n { color: var(--m-brand); border-color: rgba(240, 78, 35, 0.4); }

  .cta-row { margin-top: var(--m-space-5); }
</style>
