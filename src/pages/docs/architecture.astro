    style LANES fill:#A8D4B80F,stroke:#A8D4B866,color:#A8D4B8
    style GAUNT fill:#F2BD5C0F,stroke:#F2BD5C66,color:#F2BD5C
    style WORK  fill:#FF5E7A0F,stroke:#FF5E7A66,color:#FF5E7A
    style SPINE fill:#56B8FF14,stroke:#56B8FF80,color:#56B8FF
    style PROJ  fill:#A8D4B80F,stroke:#A8D4B866,color:#A8D4B8
