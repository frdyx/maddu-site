---
import Layout from '../layouts/Layout.astro';
import Mermaid from '../components/Mermaid.astro';
import Workflow from '../components/Workflow.astro';
import Stages from '../components/Stages.astro';
import Annotated from '../components/Annotated.astro';
import Callout from '../components/Callout.astro';
import Rule from '../components/Rule.astro';
import Legend from '../components/Legend.astro';
import SubstrateLoop from '../components/SubstrateLoop.astro';
import PageNext from '../components/PageNext.astro';
import CompareStrip from '../components/CompareStrip.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { VERSION_SHORT, VERBS_TOTAL, PURPOSE_AREAS, DOCTOR_GATES, STRESS_SCENARIOS, HARD_RULES } from '../data/stats';
---

<Layout title="The governance & coordination layer for AI coding agents" pathname="/">
  <!-- ── HERO ─────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container">
      <div class="eyebrow-chain">
        <span class="eyebrow">{VERSION_SHORT}</span>
        <span class="eyebrow-sep">·</span>
        <span class="eyebrow-dim">no cloud</span>
        <span class="eyebrow-sep">·</span>
        <span class="eyebrow-dim">no database</span>
        <span class="eyebrow-sep">·</span>
        <span class="eyebrow-dim">no provider SDKs in your code</span>
      </div>
      <h1 class="hero-title">
        Your AI agents are temporary.<br />
        The system that <em>governs</em> them shouldn't be.
      </h1>
      <p class="hero-lede">
        Máddu gives <span class="verb">claude-code</span>, <span class="verb">codex</span>, and any CLI agent a shared lane map, approvals, and a replayable record — so they work as an auditable team. Local-first files as the system of record. Never in the request path. Never near your keys.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-cmd" href="/install"><span class="cmd-prompt" aria-hidden="true">$</span> npx github:frdyx/maddu init</a>
        <a class="btn" href="/how-it-works">Read the docs <span aria-hidden="true">→</span></a>
      </div>
      <dl class="hero-stats">
        <div><dt>Hard rules</dt><dd>{HARD_RULES}</dd></div>
        <div><dt>Doctor gates</dt><dd>{DOCTOR_GATES}</dd></div>
        <div><dt>Stress scenarios</dt><dd>{STRESS_SCENARIOS}</dd></div>
        <div><dt>Auto-repair</dt><dd>0</dd></div>
      </dl>

      <CompareStrip
        items={[
          { label: 'Tracing tools', verdict: 'observe runs' },
          { label: 'Memory layers', verdict: 'remember' },
          { label: 'Máddu', verdict: 'governs how agents collaborate', emphasized: true },
        ]}
      />
      <p class="hero-compare-more">
        <a href="/compare">The full landscape — who we compete with, who we complement <span aria-hidden="true">→</span></a>
      </p>

      <SubstrateLoop />
    </div>
  </section>

  <!-- ── WHAT IT IS ──────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 01 · Definition</span>
        <h2>What it is, in one paragraph.</h2>
        <p>
          Máddu is the <em>external, cooperative governance and coordination layer for CLI coding agents</em>. Not a model. Not an agent framework competing with Hermes or clawdbot. Not a SaaS. It's the layer underneath those — the lane map, the approval gates, and the shared coordination state that let several agents work one codebase as an auditable team. Cooperative means exactly this: the agent calls Máddu; Máddu never sits in the request path and never touches your keys.
        </p>
        <p>
          What <strong>every</strong> install gets from day one is the always-on core: register a session, claim a lane, run a slice, stop it with a structured summary, let the gates check it — each one line on the spine. <strong>That disciplined loop is the product.</strong>
        </p>
        <p>
          Multi-agent orchestration — <span class="verb">coordinator</span>, <span class="verb">loop</span>, <span class="verb">pipeline</span>, <span class="verb">team</span> — is a powerful <em>opt-in</em> layer on top. Reach for it when a job fans out across lanes; skip it when it doesn't. Most work just needs the loop, and that's by design.
        </p>
      </header>

      <div class="grid-3">
        <div class="panel">
          <div class="panel-head">
            <span class="panel-title">Local-first</span>
            <span class="panel-aside">rule #1 · #3</span>
          </div>
          <p>State is files on your disk. NDJSON event log, JSON projections, typed Markdown. If you can't <code>cat</code> it, Máddu didn't write it.</p>
        </div>
        <div class="panel">
          <div class="panel-head">
            <span class="panel-title">Runtime-agnostic</span>
            <span class="panel-aside">vendor-portable</span>
          </div>
          <p>Drive it with <span class="verb">claude-code</span>, <span class="verb">codex</span>, <span class="verb">gemini</span>, or any subprocess-spawnable agent CLI. The coordinator is a Máddu primitive.</p>
        </div>
        <div class="panel">
          <div class="panel-head">
            <span class="panel-title">Audit by construction</span>
            <span class="panel-aside">rule #2 · #9</span>
          </div>
          <p>Every transition is one event on the spine. Replay is deterministic. Provenance is stamped at the source, never inferred.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── WHY IT EXISTS ───────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 02 · The gap</span>
        <h2>Capability gets the attention. <span class="dim">Accountability is the actual gap.</span></h2>
        <p>
          Multi-agent systems don't usually fail by crashing. They fail by being confidently wrong, propagating that wrong decision across fuzzy natural-language handoffs, and leaving nobody able to say what happened or whose fault it was. That's the failure mode Máddu is built around.
        </p>
      </header>

      <div class="split">
        <div class="split-col split-col--fails">
          <h4>Failure mode it kills</h4>
          <ul>
            <li>An agent silently propagating a wrong call across handoffs</li>
            <li>State-mutating actions firing with no gate and no record</li>
            <li>Cleanup that turns into a finger-pointing match</li>
            <li>Orchestration that dies when the vendor's API does</li>
          </ul>
        </div>
        <div class="split-col split-col--works">
          <h4>Posture it builds instead</h4>
          <ul>
            <li>Every handoff = one event, provenance-stamped</li>
            <li>Every mutating action crosses an allowlist + cooldown gauntlet</li>
            <li>Replay reconstructs full history deterministically</li>
            <li>Orchestration runs on any agent CLI, on any machine, offline</li>
          </ul>
        </div>
      </div>

      <Callout tone="warn" title="Construction-lawsuit chain of custody" tag="design model">
        <p>
          Logs and receipts aren't enough. The model that fits the problem is an immutable record of who changed what, when, and why — that survives the agent that produced it. That's why the spine is append-only NDJSON, projections rebuild from it and are never authoritative, and <strong>there is no auto-repair</strong>. Verifiable, not declared.
        </p>
      </Callout>
    </div>
  </section>

  <!-- ── FEATURES — what it does for you ─────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 03 · What it does for you</span>
        <h2>The discipline loop, plus everything it earns you.</h2>
        <p>Eight things an install actually gives you — each with its own page.</p>
      </header>
      <div class="feat-grid">
        <a class="deep-card deep-card--accent" href="/features/discipline">
          <span class="deep-glyph">⌗</span>
          <h3>Session discipline</h3>
          <p>Hooks auto-register every session, close it cleanly, and checkpoint governance before every context compaction. Never build unrecorded.</p>
          <span class="deep-cta">/features/discipline →</span>
        </a>
        <a class="deep-card deep-card--accent-2" href="/features/worktrees">
          <span class="deep-glyph">⑂</span>
          <h3>Worktree lanes</h3>
          <p>Each lane can claim its own isolated git worktree — parallel agents never share a checkout, every event lands on one spine. New in 1.93.</p>
          <span class="deep-cta">/features/worktrees →</span>
        </a>
        <a class="deep-card deep-card--warn" href="/features/autonomy">
          <span class="deep-glyph">⟁</span>
          <h3>Earned autonomy</h3>
          <p>A deterministic trust ladder over verified slice outcomes recommends — never applies — relaxing a lane's governance. Trust is earned on the record.</p>
          <span class="deep-cta">/features/autonomy →</span>
        </a>
        <a class="deep-card deep-card--accent" href="/features/learn">
          <span class="deep-glyph">∴</span>
          <h3>Failure learning</h3>
          <p>Mines past sessions for failed→succeeded tool calls and distils corrections. A fix learned once propagates across your repos.</p>
          <span class="deep-cta">/features/learn →</span>
        </a>
        <a class="deep-card deep-card--accent-2" href="/features/fleet">
          <span class="deep-glyph">⛁</span>
          <h3>Fleet view</h3>
          <p>Every install on your machine at a glance — stale, live, or abandoned — with staged upgrades that stop on the first red. Offline.</p>
          <span class="deep-cta">/features/fleet →</span>
        </a>
        <a class="deep-card deep-card--ok" href="/features/ci">
          <span class="deep-glyph">✓</span>
          <h3>Governance in CI</h3>
          <p>The headless, LLM-free gate rail. Red only on gates <em>you</em> pinned — framework churn never breaks your pipeline.</p>
          <span class="deep-cta">/features/ci →</span>
        </a>
        <a class="deep-card deep-card--brand" href="/features/focus">
          <span class="deep-glyph">⊙</span>
          <h3>Focus Director</h3>
          <p>Tags every turn toward, lateral, or away from the declared goal and flags sustained drift. Asks — never blocks.</p>
          <span class="deep-cta">/features/focus →</span>
        </a>
        <a class="deep-card deep-card--danger" href="/features/cost">
          <span class="deep-glyph">¤</span>
          <h3>Cost accounting</h3>
          <p>Token rollups per session, day, runtime, and model — with an opt-in budget gate that catches a runaway session before it's a surprise.</p>
          <span class="deep-cta">/features/cost →</span>
        </a>
      </div>
      <p class="see-all">
        <a class="btn" href="/features">All features <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- ── DIAGRAM — quick mental model ────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 04 · The spine</span>
        <h2>The one canonical flow.</h2>
        <p>
          Máddu has one mental model and one default execution path. They're the same loop at two altitudes — the slash and autopilot surfaces are friendly wrappers over the spine, never competing flows. Every transition lands as one readable line on an append-only record: governance you can trust because you can read it.
        </p>
      </header>

      <Workflow
        eyebrow="Substrate loop"
        title="Six transitions. Each one = one event on the spine."
        subtitle="The mental model every layer of Máddu reduces to."
        index="01 / 02"
        meta="files-only · append-only"
        tone="accent"
      >
        <Stages
          stages={[
            { label: 'register', sub: 'session',  tone: 'session' },
            { label: 'claim',    sub: 'lane',     tone: 'lane' },
            { label: 'slice',    sub: 'work',     tone: 'framework' },
            { label: 'stop',     sub: 'slice',    tone: 'approval' },
            { label: 'release',  sub: 'lane',     tone: 'lane' },
            { label: 'close',    sub: 'session',  tone: 'session' },
          ]}
          numbered
        />
        <Mermaid
          caption="Spine view — every transition appends, hindsight feeds memory"
          aside="6 transitions · 1 spine"
          code={`
flowchart LR
    A([session register]):::session --> B([claim lane]):::lane
    B --> C([slice of work]):::framework
    C --> D{slice-stop}:::approval
    D -->|release| E([lane release]):::lane
    E --> F([session close]):::session
    D -.hindsight.-> G[[skills + memory]]:::accent
    A -.events.-> S[("append-only<br/>spine")]:::spine
    B -.events.-> S
    C -.events.-> S
    D -.events.-> S
    E -.events.-> S
`}
        />
        <Fragment slot="outcome">
          Replay is deterministic. Every projection rebuilds from the spine alone.
        </Fragment>
      </Workflow>
      <Legend
        label="Color key"
        items={[
          { tone: 'session',   label: 'session lifecycle' },
          { tone: 'lane',      label: 'lane operations' },
          { tone: 'framework', label: 'slice · framework lifecycle' },
          { tone: 'approval',  label: 'slice-stop · approval gate' },
          { tone: 'accent',    label: 'hindsight · skills + memory' },
          { tone: 'spine',     label: 'the spine' },
        ]}
      />

      <Workflow
        eyebrow="Default execution path"
        title="ship-a-feature — the pipeline an agent reaches for first."
        subtitle="Each stage is a literal maddu verb. Walking the pipeline populates every cockpit surface by construction."
        index="02 / 02"
        meta="8 stages · 1 charter"
        tone="accent-2"
      >
        <Stages
          stages={[
            { label: 'orient',     tone: 'framework' },
            { label: 'plan',       tone: 'accent' },
            { label: 'coordinate', tone: 'accent' },
            { label: 'slice',      tone: 'lane' },
            { label: 'test',       tone: 'ok' },
            { label: 'review',     tone: 'ok' },
            { label: 'land',       tone: 'accent-2' },
            { label: 'account',    tone: 'session' },
          ]}
          numbered
        />
        <Annotated
          columns={['Verb', 'What it does', 'Spine event']}
          rows={[
            { action: 'maddu brief',         effect: 'turn-start orientation digest',    provenance: 'BRIEF_RENDERED',     provTone: 'framework' },
            { action: 'maddu plan',          effect: 'decompose goal into phases',       provenance: 'PLAN_PERSISTED',     provTone: 'accent' },
            { action: 'maddu coordinator',   effect: 'fan work across the team',         provenance: 'COORDINATOR_STARTED', provTone: 'accent' },
            { action: 'maddu lane claim',    effect: 'bound concurrency to one area',    provenance: 'LANE_CLAIMED',       provTone: 'lane' },
            { action: 'maddu review',        effect: 'gate the slice through quality',   provenance: 'REVIEW_RAN',         provTone: 'ok' },
            { action: 'maddu slice-stop',    effect: 'structured close + hindsight',     provenance: 'SLICE_STOPPED',      provTone: 'approval' },
          ]}
        />
        <Fragment slot="outcome">
          Three default pipelines ship — <span class="verb">ship-a-feature</span>, <span class="verb">fix-a-bug</span>, <span class="verb">plan-and-delegate</span>.
        </Fragment>
      </Workflow>
    </div>
  </section>

  <!-- ── HARD RULES PREVIEW ──────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 05 · The identity</span>
        <h2>The 8+1 hard rules.</h2>
        <p>
          Not policy on top of features. The things every feature has to be compatible with to exist at all. <span class="verb">maddu doctor</span> proves them on every install and every upgrade.
        </p>
      </header>
      <div class="grid-2">
        <Rule num="1" title="Files-only state" enforcedBy="doctor · files-only-state">
          <p>Every state write is append-only NDJSON, a rebuildable JSON projection, or a typed Markdown/JSON definition. No SQLite, no embedded DB, no hosted DB.</p>
        </Rule>
        <Rule num="2" title="Append-only event spine" enforcedBy="maddu spine verify">
          <p>The spine is the single source of truth. Projections rebuild from it and are never authoritative. Verifiable, never auto-repaired.</p>
        </Rule>
        <Rule num="3" title="No hosted backends" enforcedBy="architectural">
          <p>Provider APIs are called from local subprocess workers only. No SaaS, no telemetry, no relay, no "Máddu Cloud."</p>
        </Rule>
        <Rule num="9" title="Auto-trigger gauntlet" enforcedBy="strict-mode-approval-active">
          <p>No state-mutating command auto-fires without an allowlist entry, a respected cooldown, and a <code>TRIGGER_FIRED</code> event carrying provenance.</p>
        </Rule>
      </div>
      <p class="see-all">
        <a class="btn" href="/hard-rules">See all nine rules <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- ── DEEP DIVES ───────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">§ 06 · Go deeper</span>
        <h2>The full ontology, one layer at a time.</h2>
      </header>
      <div class="deep-grid">
        <a class="deep-card deep-card--accent" href="/architecture">
          <span class="deep-glyph">◆</span>
          <h3>Architecture</h3>
          <p>The fourteen layers. Invariants, operator, runtime, execution topology, substrate, lanes, gauntlet, workers, spine, projections, security, quality, memory, cockpit.</p>
          <span class="deep-cta">Open the ontology →</span>
        </a>
        <a class="deep-card deep-card--accent-2" href="/how-it-works">
          <span class="deep-glyph">↳</span>
          <h3>How it works</h3>
          <p>Walk the canonical flow stage by stage. Pipelines, the coordinator primitive, slice-stops, hindsight, replay determinism.</p>
          <span class="deep-cta">Walk the flow →</span>
        </a>
        <a class="deep-card deep-card--danger" href="/security">
          <span class="deep-glyph">⛨</span>
          <h3>Security</h3>
          <p>Worker isolation, env allowlist, secret scan, dependency pinning, MCP provenance, OAuth device-bound tokens, threat model.</p>
          <span class="deep-cta">Threat model →</span>
        </a>
        <a class="deep-card deep-card--warn" href="/governance">
          <span class="deep-glyph">⚖</span>
          <h3>Governance</h3>
          <p>The three tiers — strict, standard, relaxed. Gauntlet, approval flow, slice-stop discipline.</p>
          <span class="deep-cta">Open the gauntlet →</span>
        </a>
        <a class="deep-card deep-card--accent" href="/capabilities">
          <span class="deep-glyph">∷</span>
          <h3>Capabilities</h3>
          <p>Every top-level verb traces to a stated purpose. {PURPOSE_AREAS} purpose areas. {VERBS_TOTAL} verbs. One charter that flags drift.</p>
          <span class="deep-cta">Open the verb map →</span>
        </a>
        <a class="deep-card deep-card--brand" href="/hard-rules">
          <span class="deep-glyph">※</span>
          <h3>Hard rules</h3>
          <p>The 8+1 invariants in full — what they mean, what enforces them, what's deliberately absent because of them.</p>
          <span class="deep-cta">Read the charter →</span>
        </a>
      </div>
    </div>
  </section>

  <PageNext
    eyebrow="§ 07 · Continue"

    title="How it works — walk the canonical flow stage by stage."
    hint="Substrate loop, pipelines, the coordinator primitive, slice-stops, hindsight, replay determinism."
    href="/how-it-works"
    tone="accent"
  />

  <!-- ── DELIBERATELY ABSENT ─────────────────────────────────────── -->
  <section class="section absent-section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow eyebrow-danger">§ 08 · The posture</span>
        <h2>Deliberately absent. <span class="dim">Not missing features.</span></h2>
        <p>Every "no" is what makes the "yes"es trustworthy.</p>
      </header>
      <ul class="absent-grid">
        <li><span class="absent-no">no</span> SaaS · no Máddu Cloud</li>
        <li><span class="absent-no">no</span> telemetry · no relay</li>
        <li><span class="absent-no">no</span> hosted DB · no SQLite</li>
        <li><span class="absent-no">no</span> provider SDKs in app code</li>
        <li><span class="absent-no">no</span> auto-repair, ever</li>
        <li><span class="absent-no">no</span> cross-machine token sync</li>
        <li><span class="absent-no">no</span> Hermes pattern <span class="absent-detail">(hosted webhook holding many users' tokens)</span></li>
        <li><span class="absent-no">no</span> scheduler thread · no worker queue · no WAL · no mutex · no websocket</li>
      </ul>
    </div>
  </section>

  <CtaBlock />
</Layout>

<style>
  .hero {
    padding: var(--m-space-20) 0 var(--m-space-16);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse at 80% 10%, rgba(86, 184, 255, 0.10), transparent 45%),
      radial-gradient(ellipse at 20% 90%, rgba(208, 255, 0, 0.07), transparent 50%);
    pointer-events: none;
  }
  .hero-title {
    font-family: var(--m-font-cond);
    font-size: var(--m-type-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin: 0 0 var(--m-space-6);
    color: var(--m-fg-0);
    max-width: 24ch;
  }
  .hero-title em {
    color: var(--m-accent);
    font-style: italic;
    border-bottom: 0;
    text-shadow: 0 0 24px rgba(208, 255, 0, 0.4);
  }
  .hero-lede {
    font-size: 17px;
    color: var(--m-fg-1);
    max-width: 64ch;
    line-height: 1.55;
    margin-bottom: var(--m-space-4);
  }
  .hero-actions {
    display: flex;
    gap: var(--m-space-3);
    margin: var(--m-space-8) 0 var(--m-space-12);
    flex-wrap: wrap;
  }
  .hero-compare-more {
    margin: calc(-1 * var(--m-space-3)) 0 var(--m-space-8);
    font-family: var(--m-font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .btn-cmd {
    font-family: var(--m-font-mono);
    letter-spacing: 0;
    text-transform: none;
  }
  .cmd-prompt { opacity: 0.6; margin-right: 2px; }
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--m-space-5);
    border-top: 1px solid var(--m-line-soft);
    padding-top: var(--m-space-6);
    max-width: 720px;
    margin: 0;
  }
  .hero-stats div { display: flex; flex-direction: column; gap: 4px; }
  .hero-stats dt {
    font-family: var(--m-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--m-fg-3);
  }
  .hero-stats dd {
    margin: 0;
    font-family: var(--m-font-cond);
    font-weight: 600;
    font-size: 28px;
    color: var(--m-accent);
    line-height: 1;
  }

  .see-all { margin-top: var(--m-space-6); }

  .eyebrow-danger { color: var(--m-danger); }

  /* Deep-dive grid — tone-coded per card */
  .deep-grid,
  .feat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--m-space-4);
  }
  .deep-card {
    display: flex;
    flex-direction: column;
    gap: var(--m-space-3);
    padding: var(--m-space-5);
    background: var(--m-bg-2);
    border: 1px solid var(--m-line);
    border-top: 1px solid var(--m-line);
    border-radius: var(--m-radius);
    color: var(--m-fg-1);
    transition: border-color 120ms, transform 120ms, box-shadow 120ms, background 120ms;
  }
  .deep-card--accent     { border-top-color: var(--m-accent); }
  .deep-card--accent-2   { border-top-color: var(--m-accent-2); }
  .deep-card--warn       { border-top-color: var(--m-warn); }
  .deep-card--danger     { border-top-color: var(--m-danger); }
  .deep-card--brand      { border-top-color: var(--m-brand); }
