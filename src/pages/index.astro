---
import Layout from '../layouts/Layout.astro';
import CompareStrip from '../components/CompareStrip.astro';
import CtaBlock from '../components/CtaBlock.astro';
import SubstrateLoop from '../components/SubstrateLoop.astro';
import EventStream from '../components/EventStream.astro';
import { VERSION_SHORT, VERBS_TOTAL, DOCTOR_GATES, HARD_RULES, RELEASE_COUNT, EVENT_TYPES } from '../data/stats';
import { RELEASES } from '../data/releases';

// Marketing homepage — leads with verification + the record-as-contract, then
// the seven shapes of work. Reference material (architecture, governance,
// verbs) lives in the dedicated docs section at /docs; this page sells there.

// The three-legged trust claim — the spine's identity.
const contractLegs = [
  {
    n: '01',
    tone: 'accent-2',
    title: 'Tamper-evident',
    lead: 'Append-only + hash-chained',
    body: 'Every event is one line on a log that only grows, each hashed over the last. Nothing already written can change unnoticed.',
  },
  {
    n: '02',
    tone: 'accent',
    title: 'Replayable',
    lead: 'Deterministic projections',
    body: 'Everything under .maddu/state/ is a projection — rebuilt from the spine, discarded on conflict. The spine always wins; there is no repair.',
  },
  {
    n: '03',
    tone: 'brand',
    title: 'Independently checkable',
    lead: 'Published, versioned contract',
    body: 'Every event conforms to a real JSON Schema, fingerprinted so it can’t silently drift. A third party who trusts neither you nor Máddu can validate your record with off-the-shelf tooling.',
  },
];

// Seven shapes of work over the same substrate. Diagrams are the navy-noir
// SVGs from the maddu repo (recolored to brand tokens), served from /images;
// click to enlarge via the lightbox at the foot of the page.
const useCases = [
  {
    n: '01', emoji: '🔍', title: 'Verify the agent instead of trusting it', svg: '/images/use-case-verify.svg',
    intro: 'For anyone who’s been burned by “done ✅, tests pass” that wasn’t. Generation stopped being the bottleneck — verification is. An agent’s chat summary is the actor grading its own work; Máddu makes the record the witness instead.',
    cmd: `maddu hooks install
# sessions auto-register; nothing runs unrecorded
# … agent works, then:
maddu slice-stop "…"
# deliverables + gates + learnings → one line on the spine
maddu learn scan
# hedged "should work" claims vs OBSERVED proof
maddu orient
# goal progress verified by commands, not vibes`,
    caption: 'Every completion claim is joined against observed evidence — real gate passes, verified deliverables, actual diffs. A model checking a model is a second opinion; this is evidence.',
  },
  {
    n: '02', emoji: '🚀', title: 'The independent app builder', svg: '/images/use-case-builder.svg',
    intro: 'For the solo dev shipping a real product with Claude Code or Codex. You don’t want ceremony — you want to say “ship the login form,” walk away, and trust what you find. The discipline loop runs underneath without you thinking about it.',
    cmd: `npx github:frdyx/maddu init && maddu hooks install
# once
/maddu-autopilot ship the login form
# end-to-end pipeline
# overnight? every iteration lands as a slice-stop with gate results
maddu orient
# morning: the timeline, not a 100k-line transcript`,
    caption: 'Overnight autonomous runs become reviewable: pre-compaction checkpoints mark what survived context loss, the focus instrument tags each turn toward / lateral / away from your declared goal, and the morning is a ten-minute skim of slice-stops with gate badges — not an archaeology dig.',
  },
  {
    n: '03', emoji: '👥', title: 'A team sharing one repo', svg: '/images/use-case-team.svg',
    intro: 'For teams whose agents (and humans) keep stepping on each other. The record syncs through the git remote you already have — no server, no daemon, no new credentials, no vendor between you and your own history.',
    cmd: `maddu spine sync init
# opt in; this checkout gets its own partition
maddu spine sync
# commit own segments → pull → validate → audited push
maddu status
# contentions surface BY NAME — never silent double-writes`,
    caption: 'Each checkout appends only to its own partition, so git never line-merges the record. Identity rides your remote’s own access control. Concurrent claims on the same lane don’t corrupt anything — the merged read surfaces them as contentions with the superseded sessions named.',
  },
  {
    n: '04', emoji: '🐝', title: 'A swarm of parallel agents', svg: '/images/use-case-swarm.svg',
    intro: 'For operators running 3–20 coding agents at once — Agent Teams, Conductor, Claude Squad, or your own scripts. Git worktrees became the consensus isolation primitive; Máddu is the durable record underneath whichever spawner you use, not a competing one.',
    cmd: `maddu lane claim payments --worktree
# isolated checkout, bound to the claim
# … each agent works its own lane, appends to the SAME primary spine …
maddu lane release payments --worktree merged
# explicit disposition — verified, not asserted`,
    caption: 'One agent per lane is a hard rule, --worktree gives each its own checkout on its own branch, and the merged disposition actually checks git merge-base — Máddu never runs your merge, it verifies you did. The dashboards vanish when the run ends; the record survives it.',
  },
  {
    n: '05', emoji: '✅', title: 'CI for agents', svg: '/images/use-case-ci.svg',
    intro: 'For repos that want agent work held to the same bar as human PRs. One CI step reads the record and exits nonzero when the evidence is missing — deterministic, no LLM, no network.',
    cmd: `# .github/workflows/agents.yml
- run: npx github:frdyx/maddu ci
# gates ran? deliverables real? secrets clean? claims backed?`,
    caption: 'You pin which gates are required (maddu ci pin), so framework upgrades can never turn your pipeline red without your opt-in. The same exit code drives GitHub Actions, GitLab, or a fully-offline git pre-push hook.',
  },
  {
    n: '06', emoji: '🎓', title: 'Governed experience data', svg: '/images/use-case-export.svg',
    intro: 'For teams fine-tuning small models on their own agent trajectories — and anyone who owes an auditor an account. The 2026 training stack standardized the trajectory format, but the leading protocol leaves redaction, secrets, and governance out of scope. That’s the part Máddu does.',
    cmd: `maddu experience
# the spine as trajectories of typed steps + outcome signals
maddu evolve plan
# evidence-gated recs — or an honest "change nothing"
maddu experience export --format atdp --out exp.atdp.json
# the governed boundary
maddu export --otel
# or: OpenTelemetry logs into the stack you already run`,
    caption: 'The export is deterministic (byte-identical re-runs — that is the audit trail), refuses outright on any secret-shaped value with no override flag, and ships trainingEligibility: false until you — not a regex — judge the data. The honest on-ramp into trajectory-curation pipelines, not a dataset grab; a building block for record-keeping regimes like the EU AI Act (Art. 12), not a compliance product.',
  },
  {
    n: '07', emoji: '🏭', title: 'The SLM factory — governing model training', svg: '/images/use-case-slm.svg',
    intro: 'For teams fine-tuning domain-specific small models. TRL/PEFT train, vLLM serves, SWE-bench and BFCL evaluate — excellent tools, none of them the neutral record of what happened between the steps. Máddu is: datasets, runs, evals, and promotions land as hash-pinned manifests, and a checkpoint’s stage is derived from the record.',
    cmd: `maddu model dataset snapshot models/tickets-v3.json
# license, split, provenance — recorded + pinned
maddu model train complete models/run-42.json
# config of record: base hash, seed, commit
maddu model eval record models/eval-7.json
# + critical regressions: acknowledged or blocking
maddu model promote models/promote.json
# the approval ride — no auto-decide near production
maddu model gates install
# 12 ML-lifecycle gates in .maddu/gates/ — yours, ci-pinnable`,
    caption: 'Every promotion above candidate waits for an explicit per-request decision — standing approval policies are deliberately inert near production. Rollback is strictly downward; re-promotion goes through the full ride, and the spine verifier holds the ladder tamper-evident on replay. The honesty line is structural: Máddu records what your tools declared and pins the bytes — it never trains, serves, evaluates, or decides a model is good.',
  },
];

const features = [
  { tone: 'accent',   glyph: '⌗', title: 'Session discipline', body: 'Hooks auto-register every session, close it cleanly, and checkpoint governance before every compaction. Never build unrecorded.', href: '/features/discipline' },
  { tone: 'accent-2', glyph: '⑂', title: 'Worktree lanes',     body: 'Each lane claims its own isolated git worktree — parallel agents never share a checkout, every event lands on one spine.', href: '/features/worktrees' },
  { tone: 'warn',     glyph: '⟁', title: 'Earned autonomy',    body: 'A deterministic trust ladder over verified outcomes recommends relaxing a lane’s governance — never applies it.', href: '/features/autonomy' },
  { tone: 'accent',   glyph: '∴', title: 'Failure learning',   body: 'Mines past sessions for failed→succeeded tool calls and distils corrections. A fix learned once propagates across repos.', href: '/features/learn' },
  { tone: 'accent-2', glyph: '⛁', title: 'Fleet view',         body: 'Every install on your machine at a glance — stale, live, abandoned — with staged upgrades that stop on the first red.', href: '/features/fleet' },
  { tone: 'ok',       glyph: '✓', title: 'Governance in CI',   body: 'The headless, LLM-free gate rail. Red only on the gates you pinned — framework churn never breaks your pipeline.', href: '/features/ci' },
  { tone: 'brand',    glyph: '⊙', title: 'Focus Director',     body: 'Tags every turn toward, lateral, or away from the declared goal and flags sustained drift. Asks — never blocks.', href: '/features/focus' },
  { tone: 'danger',   glyph: '¤', title: 'Cost & budget',      body: 'Token rollups per session, day, runtime, and model — with an opt-in gate that catches a runaway before it surprises you.', href: '/features/cost' },
];
---

<Layout title="The governance & coordination layer for AI coding agents" pathname="/">
  <!-- ── HERO ─────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container">
      <div class="eyebrow-chain">
        <span class="eyebrow">Local-first</span>
        <span class="eyebrow-sep">·</span>
        <span class="eyebrow-dim">files-only</span>
        <span class="eyebrow-sep">·</span>
        <span class="eyebrow-dim">cooperative</span>
      </div>
      <h1 class="hero-title">
        Your AI agents are temporary.<br />
        The system that <em>governs</em> them shouldn&rsquo;t be.
      </h1>
      <p class="hero-lede">
        Máddu is a local-first orchestration spine for AI agents — the external, cooperative layer any coding agent plugs into to work as an auditable team. The agent calls Máddu; Máddu never sits in the request path and never touches your keys.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-cmd" href="/install"><span class="cmd-prompt" aria-hidden="true">$</span> npx github:frdyx/maddu init</a>
        <a class="btn" href="/docs">Read the docs <span aria-hidden="true">→</span></a>
      </div>

      <CompareStrip
        items={[
          { label: 'Tracing tools', verdict: 'observe runs' },
          { label: 'Memory layers', verdict: 'remember' },
          { label: 'Máddu', verdict: 'governs how agents collaborate', emphasized: true },
        ]}
      />

      <SubstrateLoop />
    </div>
  </section>

  <!-- ── PROBLEM → SOLUTION ──────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">The problem</span>
        <h2>&ldquo;Done ✅, tests pass.&rdquo; <span class="dim">Was it?</span></h2>
        <p>Generation stopped being the bottleneck — verification is. An agent&rsquo;s chat summary is the actor grading its own work. Máddu makes the record the witness instead: an append-only, tamper-evident, independently-checkable log of what your agents actually did.</p>
      </header>

      <div class="split">
        <div class="split-col split-col--fails">
          <h4>Without a governance layer</h4>
          <ul>
            <li>An agent silently propagates a wrong call across handoffs</li>
            <li>State-mutating actions fire with no gate and no record</li>
            <li>Cleanup turns into a finger-pointing match</li>
            <li>Orchestration dies when the vendor's API does</li>
          </ul>
        </div>
        <div class="split-col split-col--works">
          <h4>With Máddu underneath</h4>
          <ul>
            <li>Every handoff is one event, provenance-stamped</li>
            <li>Every mutating action crosses an allowlist + cooldown gauntlet</li>
            <li>Replay reconstructs the full history deterministically</li>
            <li>Orchestration runs on any agent CLI, on any machine, offline</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── THE RECORD IS A CONTRACT (pillar) ───────────────────────── -->
  <section class="section contract-section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">The record is a contract</span>
        <h2>Not a log you&rsquo;re asked to trust. <span class="dim">A contract a third party can verify.</span></h2>
        <p>The record is <em>how</em> the governance earns trust. Three properties make it evidence instead of assertion.</p>
      </header>
      <div class="contract-grid">
        {contractLegs.map((leg) => (
          <article class={`contract-card m-card m-card--${leg.tone}`}>
            <span class="contract-n">{leg.n}</span>
            <span class="contract-lead">{leg.lead}</span>
            <h3 class="contract-title">{leg.title}</h3>
            <p>{leg.body}</p>
          </article>
        ))}
      </div>
      <div class="contract-artifact">
        <code class="schema-chip">docs/event-schema.json &middot; draft 2020-12 &middot; x-contractVersion 1.1.0 &middot; {EVENT_TYPES} event types</code>
        <p>
          Validate your governance record against its own published contract with <code>ajv</code>, <code>check-jsonschema</code>, or any validator — the witness is a contract a third party can verify, not a log you&rsquo;re asked to trust. And it&rsquo;s safe to hand over: every event&rsquo;s payload is redacted at the write boundary, so the record you share can&rsquo;t leak a pasted secret.
        </p>
      </div>
    </div>
  </section>

  <!-- ── SEVEN WAYS PEOPLE RUN IT ────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">Seven ways people run it</span>
        <h2>Same substrate. <span class="dim">Seven shapes of work.</span></h2>
        <p>Same substrate, seven shapes of work. Every workflow below is real commands against the same append-only record — pick the one that looks like your week.</p>
      </header>
      <div class="usecases">
        {useCases.map((u) => (
          <article class="usecase m-card">
            <div class="usecase-head">
              <span class="usecase-n">{u.n}</span>
              <h3 class="usecase-title"><span class="usecase-emoji" aria-hidden="true">{u.emoji}</span> {u.title}</h3>
            </div>
            <p class="usecase-intro">{u.intro}</p>
            <pre class="usecase-code"><code>{u.cmd.split('\n').map((line) => (
              <span class:list={['ucode-line', /^\s*#/.test(line) && 'is-comment']}>{line + '\n'}</span>
            ))}</code></pre>
            <button class="usecase-figure" data-lightbox={u.svg} data-title={u.title} aria-label={`Enlarge diagram: ${u.title}`}>
              <img class="usecase-svg" src={u.svg} alt={`${u.title} — navy-noir diagram`} loading="lazy" width="1480" height="400" />
              <span class="usecase-zoom" aria-hidden="true">⤢ enlarge</span>
            </button>
            <p class="usecase-caption">{u.caption}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS (brief) ────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">How it works</span>
        <h2>Three parts. <span class="dim">Nothing else.</span></h2>
        <p>The spine is the truth; the bridge runs the gates; the cockpit only watches. Everything under <span class="mono">.maddu/state/</span> is a projection — rebuildable, discarded on conflict. The spine always wins.</p>
      </header>
      <div class="grid-3 parts-grid">
        <div class="panel">
          <div class="panel-head"><span class="panel-title">Spine</span><span class="panel-aside">append-only</span></div>
          <p>The single source of truth: append-only NDJSON on disk, hash-chained. Every session, approval, and slice is one line. Replays deterministically — there is no <code>maddu spine repair</code>, by design.</p>
        </div>
        <div class="panel">
          <div class="panel-head"><span class="panel-title">Bridge</span><span class="panel-aside">127.0.0.1:4177</span></div>
          <p>One local Node process. Runs the gates, spawns workers with credentials handed in at spawn-time, imports zero provider SDKs, calls no cloud. The agent calls it; it never sits in the request path.</p>
        </div>
        <div class="panel">
          <div class="panel-head"><span class="panel-title">Cockpit</span><span class="panel-aside">read-only</span></div>
          <p>A static window over the spine — observe and replay, never command. Dogfooded on Máddu&rsquo;s own repo; every tile reads live from the append-only record.</p>
        </div>
      </div>
      <div class="loop-strip" role="list">
        {['register','claim','slice','stop','release','close'].map((step, i) => (
          <div class="loop-step" role="listitem">
            <span class="loop-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="loop-verb">{step}</span>
          </div>
        ))}
      </div>

      <EventStream
        eyebrow="What lands on disk · sample slice trace"
        title="spine · turn 12"
      />

      <p class="loop-more">
        <a class="btn" href="/docs/how-it-works">See how it works <span aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="/docs/architecture">Architecture <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- ── WHAT IT IS / IS NOT ─────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">Cooperative &amp; external</span>
        <h2>What it is. <span class="dim">What it isn&rsquo;t.</span></h2>
      </header>
      <div class="split">
        <div class="split-col split-col--works">
          <h4>Máddu is</h4>
          <ul>
            <li>External, cooperative, local-first, files-only</li>
            <li>A verification substrate — the record is the witness</li>
            <li>Runtime-agnostic — Claude Code, Codex, any CLI</li>
            <li>Governance that travels with <code>git clone</code></li>
          </ul>
        </div>
        <div class="split-col">
          <h4>Máddu is not</h4>
          <ul>
            <li>Not a hosted backend, not in the request path</li>
            <li>Not a memory, tracer, or model client — zero SDKs</li>
            <li>It doesn&rsquo;t touch your keys</li>
            <li>It doesn&rsquo;t run your merges — it verifies you did</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FEATURES (condensed) ────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">What an install earns you</span>
        <h2>The discipline loop, plus what it unlocks.</h2>
      </header>
      <div class="feat-grid">
        {features.map((f) => (
          <a class={`deep-card deep-card--${f.tone}`} href={f.href}>
            <span class="deep-glyph">{f.glyph}</span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            <span class="deep-cta">{f.href.replace('/docs', '')} →</span>
          </a>
        ))}
      </div>
      <p class="see-all">
        <a class="btn" href="/features">All features <span aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="/docs/features">Docs reference <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- ── WHAT'S NEW ──────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">What&rsquo;s new</span>
        <h2>Shipped small, shipped often. <span class="dim">One charter held.</span></h2>
        <p>{RELEASE_COUNT} releases and counting &mdash; every one recorded, none broke a posted invariant.</p>
      </header>
      <ul class="whatsnew">
        {RELEASES.slice(0, 4).map((r) => (
          <li>
            <a class="whatsnew-row" href={`/changelog#${r.id}`}>
              <span class={`whatsnew-type whatsnew-type--${r.type}`}>{r.type}</span>
              <span class="whatsnew-v mono">{r.v}</span>
              <span class="whatsnew-headline">{r.headline}</span>
              <span class="whatsnew-date mono">{r.date}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="see-all">
        <a class="btn" href="/changelog">Full changelog <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- ── TRUST STRIP ─────────────────────────────────────────────── -->
  <section class="section trust-section">
    <div class="container">
      <dl class="hero-stats">
        <div><dt>Hard rules</dt><dd>{HARD_RULES}</dd></div>
        <div><dt>Doctor gates</dt><dd>{DOCTOR_GATES}</dd></div>
        <div><dt>Verbs</dt><dd>{VERBS_TOTAL}</dd></div>
        <div><dt>Auto-repair</dt><dd>0</dd></div>
      </dl>
      <p class="trust-line">
        Every "no" is what makes the "yes"es trustworthy — no SaaS, no telemetry, no relay, no hosted DB, no provider SDKs in your code, no auto-repair, ever. <a href="/docs/hard-rules">The nine hard rules →</a>
      </p>
    </div>
  </section>

  <CtaBlock hint="Creates .maddu/, the runtime, and the slash-command surface — touches nothing else. maddu doctor proves the install. Then open the docs at /docs." />

  <!-- ── Diagram lightbox ────────────────────────────────────────── -->
  <div class="lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Enlarged diagram">
    <button class="lightbox-close" id="lightboxClose" aria-label="Close">✕</button>
    <figure class="lightbox-fig">
      <img id="lightboxImg" src="" alt="" />
      <figcaption id="lightboxCap"></figcaption>
    </figure>
  </div>

  <script>
    const lb = document.getElementById('lightbox');
    const lbImg = document.getElementById('lightboxImg') as HTMLImageElement;
    const lbCap = document.getElementById('lightboxCap');
    if (lb && lbImg && lbCap) {
      const open = (src: string, title: string) => {
        lbImg.src = src; lbImg.alt = title;
        lbCap.textContent = title;
        lb.classList.add('is-open');
        lb.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };
      const close = () => {
        lb.classList.remove('is-open');
        lb.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        lbImg.src = '';
      };
      document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((el) => {
        el.addEventListener('click', () =>
          open(el.getAttribute('data-lightbox') || '', el.getAttribute('data-title') || ''));
      });
      document.getElementById('lightboxClose')?.addEventListener('click', close);
      lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lb.classList.contains('is-open')) close();
      });
    }
  </script>
</Layout>

<style>
  .hero {
    padding: var(--m-space-20) 0 var(--m-space-12);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse at 80% 10%, rgba(86, 184, 255, 0.10), transparent 45%),
      radial-gradient(ellipse at 20% 90%, rgba(208, 255, 0, 0.07), transparent 50%);
    pointer-events: none;
  }
  .hero-title {
    font-family: var(--m-font-cond);
    font-size: var(--m-type-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin: 0 0 var(--m-space-6);
    color: var(--m-fg-0);
    max-width: 24ch;
  }
  .hero-title em {
    color: var(--m-accent);
    font-style: italic;
    border-bottom: 0;
    text-shadow: 0 0 24px rgba(208, 255, 0, 0.4);
  }
  .hero-lede {
    font-size: 17px;
    color: var(--m-fg-1);
    max-width: 64ch;
    line-height: 1.55;
    margin-bottom: var(--m-space-4);
  }
  .hero-actions {
    display: flex;
    gap: var(--m-space-3);
    margin: var(--m-space-8) 0 var(--m-space-8);
    flex-wrap: wrap;
  }
  .btn-cmd {
    font-family: var(--m-font-mono);
    letter-spacing: 0;
    text-transform: none;
  }
