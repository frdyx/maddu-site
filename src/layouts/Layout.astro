---
// Shared shell — nav rail, footer, brand chrome.
// Routes are defined inline; small enough not to warrant a config file.
export interface Props {
  title: string;
  description?: string;
  /** Path of current page for nav active-state highlight. */
  pathname?: string;
}

const {
  title,
  description = 'Máddu — the external, cooperative governance & coordination layer any CLI AI agent plugs into. Agents work as an auditable team: lanes, approvals, gates, replayable record. Local-first, no cloud, no key interception.',
  pathname = '/',
} = Astro.props;

const nav = [
  { href: '/', label: 'Overview', glyph: '◈' },
  { href: '/docs', label: 'Docs', glyph: '❖' },
  { href: '/features', label: 'Features', glyph: '✦' },
  { href: '/compare', label: 'Compare', glyph: '⇄' },
  { href: '/capabilities', label: 'Verbs', glyph: '∷' },
  { href: '/install', label: 'Install', glyph: '⤓' },
];

const fullTitle = pathname === '/' ? `Máddu — ${title}` : `${title} · Máddu`;
const siteUrl = 'https://maddu.frdyx.com';
const canonical = siteUrl + (pathname === '/' ? '/' : pathname.replace(/\/$/, ''));

// Per-page OG cards live at /og/<slug>.png, generated by scripts/gen-og.mjs.
// The landing card is keyed as "index"; everything else maps the leading
// path segment. Unknown pages fall back to the landing card so OG never 404s.
const OG_SLUGS = new Set([
  'index', 'how-it-works', 'architecture', 'security', 'threat-model',
  'governance', 'hard-rules', 'capabilities', 'install', 'changelog',
  'manifesto', 'brand', '404',
]);

// Per-release OG cards live at /og/changelog/<release>.png — keyed off
// the URL hash, set via inline meta-update script below (OG meta is
// rendered server-side, so for hash-based deep links the meta won't
// update; this map is used by social-card crawlers that follow the
// path-shaped redirect rule in public/_redirects).
export interface PerReleaseProps {
  /** When pathname matches /changelog and hash is set, sets og:image to /og/changelog/<hash>.png */
  releaseOg?: boolean;
}

const ogSlug = pathname === '/' ? 'index' : pathname.replace(/^\/|\/$/g, '').split('/')[0];
const ogImage = siteUrl + '/og/' + (OG_SLUGS.has(ogSlug) ? ogSlug : 'index') + '.png';

import SearchPalette from '../components/SearchPalette.astro';
import { VERSION } from '../data/stats';
---

<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- First-visit gate: send new visitors to /welcome/ once, then show the
       site. URL flags override: ?welcome forces the landing, ?site forces the
       marketing site. First-party localStorage only — no cookie, no analytics,
       so the no-tracking posture below still holds. Self-scoped to the home
       path; harmless on every other page. -->
  <script is:inline>
    (function () {
      var p = location.pathname;
      if (p !== '/' && p !== '/index.html') return;
      try {
        var qs = new URLSearchParams(location.search);
        if (qs.has('site')) { localStorage.setItem('maddu_seen', '1'); return; }
        if (qs.has('welcome')) { location.replace('/welcome/'); return; }
        var SHOW_FOR_FIRST = 1; // show the welcome landing for the first N visits to "/"
        var seen = parseInt(localStorage.getItem('maddu_seen') || '0', 10);
        if (seen < SHOW_FOR_FIRST) {
          localStorage.setItem('maddu_seen', String(seen + 1));
          location.replace('/welcome/');
        }
      } catch (e) { /* storage blocked -> just show the marketing site */ }
    })();
  </script>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#050B17" />
  <title>{fullTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/brand-mark.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <!-- Self-hosted IBM Plex (woff2 in /public/fonts/, registered by base.css)
       matches Máddu's no-third-party-network posture. Preloads the two
       heaviest weights agents see immediately. -->
  <link rel="preload" href="/fonts/plex-sans-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/plex-cond-600.woff2" as="font" type="font/woff2" crossorigin />
  <!-- Feed discovery — changelog releases publish through Atom. -->
  <link rel="alternate" type="application/atom+xml" title="Máddu changelog" href="/atom.xml" />
  <link rel="alternate" type="application/feed+json" title="Máddu changelog (JSON Feed)" href="/feed.json" />
  <!-- PWA manifest — site is installable as a lightweight app on supporting browsers. -->
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/favicon-128.png" />
  <meta name="apple-mobile-web-app-title" content="Máddu" />
  <meta name="application-name" content="Máddu" />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="scroll-progress" aria-hidden="true">
    <div class="scroll-progress-bar" id="scrollProgressBar"></div>
  </div>

  <header class="site-nav">
    <div class="site-nav-inner">
      <a class="site-brand" href="/" aria-label="Máddu home">
        <img src="/brand-mark.svg" alt="" width="22" height="22" />
        <span class="site-brand-name">Máddu</span>
        <span class="site-brand-tag">Source of local truth</span>
      </a>
      <nav class="site-nav-links" aria-label="Primary">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={['site-nav-link', pathname === item.href && 'is-active']}
          >
            <span class="site-nav-glyph" aria-hidden="true">{item.glyph}</span>
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
      <div class="site-nav-actions">
        <a class="site-nav-gh" href="https://github.com/frdyx/maddu" target="_blank" rel="noopener" aria-label="Máddu on GitHub">
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
        </a>
        <button class="site-nav-search" id="navSearch" aria-label="Search the site (Ctrl+K)">
          <span class="site-nav-search-glyph" aria-hidden="true">⌕</span>
          <span class="site-nav-search-label">Search</span>
          <kbd class="site-nav-search-kbd"><span class="site-nav-search-mod">⌘</span>K</kbd>
        </button>
        <button class="site-nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <SearchPalette />

  <main class="site-main" id="main" tabindex="-1">
    <slot />
  </main>

  <footer class="site-foot">
    <div class="container-wide site-foot-inner">
      <div class="site-foot-col">
        <div class="site-foot-brand">
          <img src="/brand-mark.svg" alt="" width="18" height="18" />
          <span>Máddu</span>
          <a class="site-foot-ver" href="/changelog">v{VERSION}</a>
        </div>
        <p class="site-foot-tagline">The Source of local truth.</p>
        <p class="site-foot-meta">The cooperative governance &amp; coordination layer for CLI AI agents. No SaaS, no telemetry, no relay. <span class="mono">{new Date().getFullYear()}</span></p>
        <p class="site-foot-privacy">
          <span class="site-foot-privacy-glyph" aria-hidden="true">◆</span>
          <span>This site sets no cookies, runs no analytics, loads no third-party scripts. The framework's posture is the site's posture.</span>
        </p>
        <p class="site-foot-credit">
          <span class="site-foot-credit-label">Created by</span>
          <a href="https://github.com/frdyx" target="_blank" rel="noopener author">Frdyx</a>
          <span class="site-foot-credit-sep" aria-hidden="true">·</span>
          <a href="https://frdyx.com" target="_blank" rel="noopener">frdyx.com</a>
          <span class="site-foot-credit-sep" aria-hidden="true">·</span>
          <a href="https://www.linkedin.com/in/freddy-gehlin-b86914124/" target="_blank" rel="noopener">LinkedIn</a>
        </p>
      </div>
      <div class="site-foot-col site-foot-col--pages">
        <h4>Pages</h4>
        <ul class="site-foot-links">
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/docs/how-it-works">How it works</a></li>
          <li><a href="/docs/architecture">Architecture</a></li>
          <li><a href="/docs/hard-rules">Hard rules</a></li>
          <li><a href="/threat-model">Threat model</a></li>
          <li><a href="/manifesto">Manifesto</a></li>
          <li><a href="/changelog">Changelog</a></li>
          <li><a href="/brand">Brand</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="https://github.com/frdyx/maddu" target="_blank" rel="noopener">GitHub ↗</a></li>
        </ul>
      </div>
      <div class="site-foot-col">
        <h4>Posture</h4>
        <ul class="site-foot-posture">
          <li><span class="tag tone-accent">files only</span></li>
          <li><span class="tag tone-accent">append-only</span></li>
          <li><span class="tag tone-accent-2">no hosted backend</span></li>
          <li><span class="tag tone-accent-2">no provider SDKs in app code</span></li>
          <li><span class="tag tone-warn">no auto-repair</span></li>
        </ul>
      </div>
    </div>
  </footer>

  <script>
    // Mobile nav toggle.
    const t = document.getElementById('navToggle');
    const links = document.querySelector('.site-nav-links');
    t?.addEventListener('click', () => {
      const open = links?.classList.toggle('is-open');
      t.setAttribute('aria-expanded', String(!!open));
    });

    // Search button — opens the palette via the global exposed by SearchPalette.
    document.getElementById('navSearch')?.addEventListener('click', () => {
      (window as any).__maddu_openSearch?.();
    });

    // Cmd/Ctrl modifier glyph for the search kbd hint — display ⌘ on
    // mac, Ctrl elsewhere. Tiny touch but matches platform conventions.
    const isMac = /Mac|iPhone|iPad|iPod/.test(navigator.platform);
    document.querySelectorAll('.site-nav-search-mod').forEach((el) => {
      el.textContent = isMac ? '⌘' : 'Ctrl ';
    });

    // Scroll progress bar — pinned under the sticky nav. Width tracks
    // scroll position as a fraction of total scrollable height.
    const bar = document.getElementById('scrollProgressBar');
    if (bar) {
      const update = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const pct = max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;
        bar.style.width = pct + '%';
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
    }

    // Heading anchors — for every h2/h3 inside a .section, generate a
    // slug-id if it doesn't have one, then append a "#" link button.
    // Lets readers share deep links to any section. CSS shows the link
    // only on hover to keep the chrome quiet at rest.
    const slugify = (s: string) =>
      s.toLowerCase()
        .replace(/[^a-z0-9 -]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');

    const used = new Set<string>();
    document.querySelectorAll<HTMLElement>('.section h2, .section h3').forEach((h) => {
      // Skip if it lives inside a component that already manages its own id
      if (h.closest('.wf, .panel, .callout, .layer, .def-card, .tier-card, .cap-card, .rule-card')) {
        return;
      }
      let id = h.id || slugify(h.textContent || '');
      if (!id) return;
      // De-dupe if two headings slug to the same id
      let base = id, n = 2;
      while (used.has(id)) id = base + '-' + n++;
      used.add(id);
      h.id = id;

      const a = document.createElement('a');
      a.href = '#' + id;
      a.className = 'heading-anchor';
      a.setAttribute('aria-label', 'Link to this section');
      a.innerHTML = '<span>#</span>';
      h.appendChild(a);
    });
  </script>

  <style is:global>
    @import '../styles/base.css';

    /* ── Skip-link — appears on keyboard focus, jumps past chrome ── */
    .skip-link {
      position: fixed;
      top: 8px;
      left: 8px;
      z-index: 100;
      transform: translateY(-200%);
      background: var(--m-accent);
      color: var(--m-bg-0);
      font-family: var(--m-font-mono);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 8px 14px;
      border: 0;
      border-radius: var(--m-radius);
      box-shadow: var(--m-glow-accent);
      transition: transform 140ms ease-out;
      border-bottom: 0;
    }
    .skip-link:focus,
    .skip-link:focus-visible {
      transform: translateY(0);
      color: var(--m-bg-0);
      border-bottom: 0;
    }
    #main { outline: none; scroll-margin-top: var(--m-nav-h); }

    /* ── Global focus-visible — accent ring on every interactive
     *    surface, so keyboard nav is legible without forcing styles
     *    onto mouse users. */
    :focus-visible {
      outline: 2px solid var(--m-accent);
      outline-offset: 2px;
      border-radius: 2px;
    }
    a:focus-visible,
    button:focus-visible,
    input:focus-visible,
    [tabindex]:focus-visible {
      outline: 2px solid var(--m-accent);
      outline-offset: 2px;
    }
    /* Inputs already have their own caret + border treatment; the ring
     * just emphasises the field without doubling the chrome. */
    input:focus-visible { outline-offset: 0; }

    /* ── Visually-hidden text — for icon-only buttons that need a label
     *    a screen reader can announce. */
    .sr-only {
      position: absolute !important;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* ── Reduced-motion — strip transitions and decorative animations
     *    site-wide so the page settles instantly for users who prefer it.
     *    Anchored functional animations (open/close) keep a brief fade. */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* ── Scroll progress (top of viewport, above the sticky nav) ──── */
    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: transparent;
      z-index: 60;
      pointer-events: none;
    }
    .scroll-progress-bar {
      height: 100%;
      width: 0;
      background: linear-gradient(90deg, var(--m-accent), var(--m-accent-2));
      box-shadow: 0 0 12px rgba(208, 255, 0, 0.45);
      transition: width 60ms linear;
    }

    /* ── Heading anchor link (hover reveal) ──────────────────────── */
    .section h2,
    .section h3 {
      position: relative;
    }
    .heading-anchor {
      position: absolute;
      left: -28px;
      top: 50%;
      transform: translateY(-50%);
      width: 22px;
      height: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--m-fg-4);
      font-family: var(--m-font-mono);
      font-size: 14px;
      border-bottom: 0;
      border-radius: var(--m-radius-sm);
      opacity: 0;
      transition: opacity 120ms, color 120ms, background 120ms;
    }
    .section h2:hover .heading-anchor,
    .section h3:hover .heading-anchor,
    .heading-anchor:focus { opacity: 1; }
    .heading-anchor:hover {
      color: var(--m-accent);
      background: var(--m-bg-2);
      border-bottom: 0;
    }
    @media (max-width: 920px) {
      .heading-anchor { left: -22px; width: 18px; height: 18px; font-size: 12px; }
    }

    /* ── Site nav ───────────────────────────────────────────────────── */
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 50;
      /* Theme-aware translucent surface — picks up --m-bg-1 from the
       * active palette (dark navy at 0.54 alpha, or warm-paper at 0.78
       * in light). Falls back to the original hardcoded navy if for
       * some reason no token is set. */
      background: var(--m-bg-1, rgba(5, 11, 23, 0.78));
      backdrop-filter: blur(18px) saturate(120%);
      -webkit-backdrop-filter: blur(18px) saturate(120%);
      border-bottom: 1px solid var(--m-line);
    }
    /* ── Site nav — full-width, fluid responsive ─────────────────────
     * No max-width on the inner: the bar spans the viewport so wide
     * screens use the space, not dead margins. Side padding is fluid
     * via clamp() — tight on mobile, generous on desktop.
     *
     * Breakpoints (binary visible vs burger — never cut text mid-word):
     *   ≥1380px   brand tag visible · all 8 nav links · search label + kbd
     *   1280-1380 brand tag hidden · all links · search label + kbd
     *   1180-1280 no kbd hint · search label still showing
     *   1080-1180 search label hidden (glyph only) · all links visible
     *   <1080px   BURGER · everything except brand collapses to drawer
     *             (eight uppercase items can't sit on one row below this
     *             without truncation; better one clean state than two)
     */
    .site-nav-inner {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0 clamp(12px, 2.4vw, 28px);
      height: var(--m-nav-h);
      /* 3-column grid: brand left · links centered · actions right.
       * The 1fr middle track expands so the link group always sits
       * at the centerline of the viewport, regardless of brand width. */
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: clamp(10px, 1.6vw, 24px);
    }
    .site-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--m-fg-0);
      border-bottom: none;
      flex-shrink: 0;
      min-width: 0;
    }
    .site-brand img {
      filter: drop-shadow(0 0 6px rgba(240, 78, 35, 0.55));
      flex-shrink: 0;
    }
    .site-brand-name {
      font-family: var(--m-font-cond);
      font-weight: 700;
      font-size: 18px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--m-fg-0);
    }
    .site-brand-tag {
      font-family: var(--m-font-mono);
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--m-fg-3);
      padding-left: 12px;
      border-left: 1px solid var(--m-line-soft);
      white-space: nowrap;
    }
    .site-brand:hover { color: var(--m-fg-0); border-bottom: none; }

    .site-nav-links {
      display: flex;
      gap: 1px;
      align-items: center;
      flex-wrap: nowrap;
      /* Centered within its grid column — no margin-left auto. */
      justify-self: center;
    }
    /* Right-side action cluster — search + theme + burger live here. */
    .site-nav-actions {
      display: flex;
      align-items: center;
      gap: clamp(4px, 0.6vw, 8px);
      justify-self: end;
    }
    .site-nav-link {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 8px 11px;
      font-family: var(--m-font-cond);
      font-size: 13px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--m-fg-2);
      border: 1px solid transparent;
      border-radius: var(--m-radius);
      transition: color 120ms, border-color 120ms, background 120ms;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .site-nav-link > span:not(.site-nav-glyph) { white-space: nowrap; }
    .site-nav-link:hover { color: var(--m-fg-0); background: var(--m-bg-2); border-bottom: 1px solid transparent; }
    .site-nav-link.is-active {
      color: var(--m-accent);
      background: var(--m-bg-2);
      border-color: var(--m-line);
    }
    .site-nav-glyph { color: var(--m-fg-4); font-family: var(--m-font-mono); flex-shrink: 0; }
    .site-nav-link.is-active .site-nav-glyph { color: var(--m-accent); }

    .site-nav-toggle {
      display: none;
      width: 36px;
      height: 36px;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 4px;
      background: transparent;
      border: 1px solid var(--m-line);
      border-radius: var(--m-radius);
      cursor: pointer;
      padding: 0;
      flex-shrink: 0;
    }
    .site-nav-toggle span { display: block; width: 16px; height: 1.5px; background: var(--m-fg-1); }

    /* Right-side actions cluster — wraps as a unit, stays together */
    .site-nav-search {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 10px;
      background: var(--m-bg-2);
      border: 1px solid var(--m-line);
      border-radius: var(--m-radius);
      font-family: var(--m-font-mono);
      font-size: 11px;
      letter-spacing: 0.06em;
      color: var(--m-fg-3);
      cursor: pointer;
      transition: border-color 120ms, color 120ms;
      flex-shrink: 0;
    }
    .site-nav-search:hover { border-color: var(--m-accent); color: var(--m-accent); }
    .site-nav-search-glyph { color: var(--m-accent); font-size: 12px; }
    .site-nav-search-label { letter-spacing: 0.08em; text-transform: uppercase; }
    .site-nav-search-kbd {
      font-family: var(--m-font-mono);
      font-size: 10px;
      padding: 1px 6px;
      background: var(--m-bg-3);
      border: 1px solid var(--m-line-soft);
      border-radius: 3px;
      color: var(--m-fg-2);
    }

    /* GitHub icon link — square action button matching the search chip. */
    .site-nav-gh {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      color: var(--m-fg-2);
      background: var(--m-bg-2);
      border: 1px solid var(--m-line);
      border-radius: var(--m-radius);
      flex-shrink: 0;
      transition: color 120ms, border-color 120ms;
    }
    .site-nav-gh:hover { color: var(--m-accent); border-color: var(--m-accent); }
    .site-nav-gh svg { display: block; }

    /* ── 1380px and down — hide brand tag ─────────────────────────── */
    @media (max-width: 1380px) {
      .site-brand-tag { display: none; }
    }

    /* ── 1280px and down — hide kbd hint on search button ─────────── */
    @media (max-width: 1280px) {
      .site-nav-search-kbd { display: none; }
    }

    /* ── 1180px and down — drop search label, compact button ──────── */
    @media (max-width: 1180px) {
      .site-nav-search-label { display: none; }
      .site-nav-search { padding: 6px 9px; }
    }

    /* ── 1080px and down — collapse links to burger drawer ────────
     * Below this width, the eight uppercase nav items can't sit on a
     * single row without truncation. Rather than half-show items (the
     * "wrapping look" of clipped text), we collapse everything to the
     * burger menu in one clean step. Grid collapses to 2 cols too
     * (brand · actions) so the bar stays balanced. */
    @media (max-width: 1080px) {
      .site-nav-inner { grid-template-columns: auto auto; justify-content: space-between; }
      .site-nav-toggle { display: flex; }
      .site-nav-links {
        position: absolute;
        top: var(--m-nav-h);
        left: 0; right: 0;
        background: var(--m-bg-0);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        padding: var(--m-space-3) clamp(14px, 3vw, 24px);
        border-bottom: 1px solid var(--m-line);
        margin: 0;
        justify-self: stretch;
        display: none;
        max-height: calc(100vh - var(--m-nav-h));
        overflow-y: auto;
      }
      .site-nav-links.is-open { display: flex; }
      .site-nav-link {
        padding: 13px 14px;
        font-size: 14px;
        gap: 10px;
        border-bottom: 1px solid var(--m-line-soft);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .site-nav-link:last-of-type { border-bottom: 0; }
    }

    /* ── 480px and down — drop search button label, tighten layout ─ */
    @media (max-width: 480px) {
      .site-nav-search { padding: 6px 8px; }
      .site-nav-search-glyph { font-size: 14px; }
    }

    /* ── Main ───────────────────────────────────────────────────────── */
    .site-main { min-height: calc(100vh - var(--m-nav-h) - 220px); }

    /* ── Footer ─────────────────────────────────────────────────────── */
    .site-foot {
      border-top: 1px solid var(--m-line);
      background: var(--m-bg-1);
      padding: var(--m-space-12) 0 var(--m-space-8);
      margin-top: var(--m-space-16);
    }
    .site-foot-inner {
      display: grid;
      grid-template-columns: 1.7fr 1.7fr 1fr;
      gap: var(--m-space-10);
    }
    .site-foot-col h4 {
      font-family: var(--m-font-cond);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 11px;
      color: var(--m-fg-3);
      margin: 0 0 var(--m-space-3);
    }
    .site-foot-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
    .site-foot-col a { color: var(--m-fg-1); border-bottom: none; font-size: 13px; }
    .site-foot-col a:hover { color: var(--m-accent); }
    /* Pages list is long — lay it out in two columns so the footer isn't a tall stack. */
    .site-foot-links { display: grid !important; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 22px; }
    .site-foot-brand {
      display: flex; align-items: center; gap: 8px;
      font-family: var(--m-font-cond);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--m-fg-0);
      margin-bottom: var(--m-space-3);
    }
    .site-foot-ver {
      font-family: var(--m-font-mono);
      font-size: 10px;
      letter-spacing: 0.06em;
      color: var(--m-accent);
      border: 1px solid var(--m-accent-dim);
      border-radius: var(--m-radius-sm);
      padding: 1px 7px;
      border-bottom: 1px solid var(--m-accent-dim);
    }
    .site-foot-ver:hover { color: var(--m-accent); background: var(--m-accent-glow-bg); border-bottom: 1px solid var(--m-accent-dim); }
    .site-foot-tagline {
      font-family: var(--m-font-mono);
      font-size: 12px;
      color: var(--m-accent-2);
      font-style: italic;
      margin: 0 0 var(--m-space-2);
    }
    .site-foot-meta { font-size: 12px; color: var(--m-fg-3); max-width: 50ch; }
    .site-foot-privacy {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      margin-top: var(--m-space-4);
      padding-top: var(--m-space-3);
      border-top: 1px dashed var(--m-line-soft);
      font-size: 11.5px;
      color: var(--m-fg-2);
      max-width: 56ch;
      font-family: var(--m-font-mono);
      line-height: 1.55;
      letter-spacing: 0.02em;
    }
    .site-foot-privacy-glyph {
      color: var(--m-accent-2);
      font-size: 9px;
      margin-top: 6px;
      flex-shrink: 0;
    }
    .site-foot-posture { flex-direction: row !important; flex-wrap: wrap; }
    .site-foot-credit {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: var(--m-space-4);
      font-family: var(--m-font-mono);
      font-size: 11.5px;
      letter-spacing: 0.02em;
      color: var(--m-fg-3);
    }
    .site-foot-credit-label { text-transform: uppercase; letter-spacing: 0.08em; color: var(--m-fg-4); }
    .site-foot-credit a { color: var(--m-fg-1); border-bottom: none; }
    .site-foot-credit a:hover { color: var(--m-accent); }
    .site-foot-credit-sep { color: var(--m-fg-4); }

    @media (max-width: 720px) {
      .site-foot-inner { grid-template-columns: minmax(0, 1fr); gap: var(--m-space-6); }
    }
  </style>
</body>
</html>
