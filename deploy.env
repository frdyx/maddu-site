# Deploy configuration for maddu-site -> Loopia  (NON-secret values only)
# Auth is handled by ssh-agent + ~/.ssh/config (host alias "loopia").
# Never put keys or passwords here.

# SSH host alias from ~/.ssh/config
SSH_HOST=loopia

# Remote site dir (relative to SSH home). Web root is $REMOTE_SITE/public_html
# maddu.frdyx.com is a subdomain -> served at its own web root.
REMOTE_SITE=maddu.frdyx.com

# Sub-folder under the web root (empty = publish straight to the web root).
REMOTE_SUBDIR=

# Local build output to publish
LOCAL_SRC=dist

# Build command + canonical URL. BASE_PATH is empty because the subdomain
# serves at root (base "/"), so no asset-path rewriting is needed.
BUILD_CMD="npm run build"
SITE_URL=https://maddu.frdyx.com
BASE_PATH=
